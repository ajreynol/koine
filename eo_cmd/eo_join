#!/usr/bin/env bash
# eo_join -- join the Eunoia ecosystem, from inside the repository that is joining.
#
# Run it in a checkout of the repository you want to join. It
# starts an assistant with a short fixed prompt that points at the instructions
# and at the checker; it does not carry the instructions itself.
#
#   eo_join                 # do it
#   eo_join --associate     # the associate footing, on the maintenance page
#   eo_join --soft          # the maintenance note only, joining nothing
#   eo_join --soft --affiliated
#                           # the same, for a repository happy to be named
#   eo_join --show-prompt   # print the prompt and exit
#   eo_join --print         # run non-interactively and print the result
#
# **Whose repository is it?** Joining writes a declaration onto a README, which
# is a claim made on that project's front page in its own voice. Where the
# repository has one owner and you are them, that is yours to make. **Where it
# is shared -- an organisation, a community, other maintainers -- it is not**,
# however much commit access you have. Commit access is capability; a front page
# is somebody's public voice, and the two are not the same thing.
#
# So for a shared tree, the sequence is agreement first and this command second,
# and plain `--soft` is what to reach for meanwhile: a maintenance note that
# names no other project at all -- no membership, no workflow, no policy link,
# and not our name either. `--affiliated` puts *our* name on somebody else's
# front page, which on a tree we do not own is a second thing to ask for rather
# than a gentler version of the first. logos reached exactly this conclusion from the other side, reversing a
# membership commit it had already pushed, on the ground that a declaration it
# could not write without naming somebody else's repositories was a declaration
# it should not write at all.
#
# **"I think I already complied with this" is a normal answer, and it is not the
# same as compliance.** Run this on a tree that already has the shape and an
# agent will often say so and stop, which is correct behaviour: the request is
# idempotent and a second run should change nothing. But the claim is about a
# state the agent did not create, and it cannot tell three cases apart -- a tree
# that ran this before, a tree that arrived at the shape independently, and a
# tree that looks compliant while its pin is stale or points at a commit our
# build failed. Treat it as a prompt to check the pin, not as a pass. This is
# the same distinction `genuine` names in scripts/ecosystem/ecosystem.json: complying now
# and having been built this way are different facts, and only the first is
# visible from the tree.
#
# --soft is a different act rather than a smaller one. It adds the maintenance
# note and stops: no membership is declared, no workflow is added and no checker
# is run, the default claim is that people maintain the repository, and the note
# disclaims any assessment of it published by somebody else's tooling. A
# repository that has not agreed to this policy is better off with that note than
# with a declaration it did not choose.
#
# It has two forms and they differ by one paragraph. The default is the
# **independent** note: the repository is part of no other project's ecosystem
# and names none. --affiliated writes the other: it names the Eunoia ecosystem as
# one it works with and says it is not held to the policy. The second is what an
# `associate` in scripts/ecosystem/ecosystem.json carries, and it is the only thing an
# associate is ever asked for.
#
# The prompts are deliberately tiny and deliberately stable. Everything that can
# change -- what the declaration says, which checks run, what is skipped -- lives
# on one page in the kanon repository, and they link to it rather than repeating
# it. If the page and this text ever disagree, the page is right.
#
# docs/policy.md defines the joining requirements and maintenance-note templates.

set -euo pipefail

AGENT=claude
PRINT=0
SHOW=0
SOFT=0
AFFIL=0
ASSOC=0

usage() {
  # An explicit --help is a request, not a mistake: it goes to stdout and exits
  # 0. A wrong flag is a mistake: stderr, exit 2. Getting this backwards makes
  # `eo_join --help | less` print nothing, which it did until 2026-09-17.
  local out=1 code=0
  if [ "${1:-}" = "error" ]; then out=2 code=2; fi
  cat >&$out <<'USAGE'
eo_join -- declare where a repository stands with the Eunoia ecosystem.

Run it at the root of the repository being declared: it writes there, not in
any checkout of the ecosystem. An assistant edits that tree -- a README
section, docs/maintenance.md, sometimes a CI workflow -- and leaves the work
staged for you to review.

usage: eo_join [--soft [--affiliated] | --associate]
               [--codex] [--print] [--show-prompt]

  (no flag)       join, and declare it on the front page
  --associate     hold this tree to the policy without announcing it, on
                  docs/maintenance.md. Owes the ecosystem nothing
  --soft          claim nothing: a maintenance note naming no other project
  --affiliated    with --soft: name the Eunoia ecosystem, held to none of it
  --codex         run codex instead of claude
  --print         run non-interactively and print the result
  --show-prompt   print the prompt and exit, running nothing

The four are different claims, not amounts of one. Read before running:
--show-prompt prints exactly what an assistant would be handed. The policy is
the authority: https://github.com/ajreynol/kanon/blob/main/docs/policy.md
USAGE
  exit $code
}

while [ $# -gt 0 ]; do
  case "$1" in
    --soft) SOFT=1; shift ;;
    --associate) ASSOC=1; shift ;;
    --affiliated) AFFIL=1; shift ;;
    --codex) AGENT=codex; shift ;;
    --claude) AGENT=claude; shift ;;
    --print) PRINT=1; shift ;;
    --show-prompt) SHOW=1; shift ;;
    -h|--help) usage ;;
    *) echo "eo_join: unknown option $1" >&2; usage error ;;
  esac
done

read -r -d '' PROMPT <<'PROMPT_END' || true
**First, one question, and stop if the answer is no.** Is this repository solely
the runner's to speak for? Joining writes a declaration onto its README, in the
repository's own voice, on its front page. If the tree is shared -- an
organisation, a community, other maintainers with a say -- **that declaration is
not the runner's alone to make, and commit access does not make it so.** In that
case: change nothing, say which repository this looks like and who else would
have to agree, and suggest **`eo_join --soft`**, which writes a maintenance note
naming **no other project at all** — no membership, no workflow, no policy link,
and not our name either. `--affiliated` names this ecosystem, and on a tree
somebody else owns that is a second thing to get agreement for rather than a
softer version of the first. Saying *this is not mine to declare* is a correct
outcome of this command.

This repository is joining the Eunoia ecosystem. One page says how, and it is
the authority:

  https://github.com/ajreynol/kanon/blob/main/docs/policy.md#joining-the-eunoia-ecosystem

Read it, then do what it says, here:

1. Declare membership at the top of the README's "How this repository is
   maintained" section, creating that section if there is not one.
2. Add the CI workflow the page gives.
3. Run the same checker revision and command the workflow uses, and fix what it
   reports. The checker is maintained in anoieu; read its instructions at the
   chosen revision. Report which revision you checked. Do not substitute the
   latest checkout for a pinned revision or claim a local run establishes CI.

Change nothing the check does not ask for, and add no file it does not ask for.
Where the page and this prompt disagree, the page is right.

Leave the work staged and not committed: `git add` what you changed and stop
there, so a maintainer reviews a diff rather than a history. Then say, in one
paragraph: what you changed, what
the check still reports, and anything the page asked for that does not fit this
repository -- that last one is worth more to us than a clean run.
PROMPT_END

read -r -d '' SOFT_PROMPT <<'SOFT_PROMPT_END' || true
*Produced by `eo_join --soft`, a command kept in the koine repository. **That
script is the authority for what this prompt asks**, and it can be read without
running anything:*

  https://github.com/ajreynol/koine/blob/main/eo_cmd/eo_join

*`eo_join --soft --show-prompt` prints exactly this text and does nothing else,
so anybody handed this can check it against what the command actually says.*

This repository is adopting one convention and joining nothing. One page defines
the convention, and it is the authority for what the note must say:

  https://github.com/ajreynol/kanon/blob/main/docs/policy.md#the-soft-form-the-note-without-the-membership

Read it, then do this here, and nothing else:

1. Add a "How this repository is maintained" section as the last section of
   README.md, creating it if there is not one, from the template that page
   gives.
2. State who maintains this repository. The default is that it is written and
   maintained by people; depart from that only where the tree itself shows
   otherwise. Say what the supervision does not cover.
3. Keep the paragraph declaring this repository independent: it is part of no
   other project's ecosystem, it adopts nobody else's repository conventions,
   and an assessment of it published by another project's tooling is that
   project's own and not this repository's.

Add no workflow file, run no checker, declare membership of nothing, and change
no file other than README.md. This repository is not joining the Eunoia
ecosystem and the section must not say or imply that it is. Where the page and
this prompt disagree, the page is right.

Leave the work staged and not committed: `git add README.md` and stop there, so
a maintainer reviews a diff rather than a history. Then say, in one paragraph:
what the section now claims about who maintains this repository, and what you
could not establish from the tree and left for a person to write.
SOFT_PROMPT_END

read -r -d '' AFFIL_PROMPT <<'AFFIL_PROMPT_END' || true
*Produced by `eo_join --soft --affiliated`, a command kept in the koine
repository. **That script is the authority for what this prompt asks**, and it
can be read without running anything:*

  https://github.com/ajreynol/koine/blob/main/eo_cmd/eo_join

*`eo_join --soft --affiliated --show-prompt` prints exactly this text and does
nothing else, so anybody handed this can check it against what the command
actually says.*

This repository is adopting one convention and joining nothing. One page defines
the convention, and it is the authority for what the note must say:

  https://github.com/ajreynol/kanon/blob/main/docs/policy.md#the-soft-form-the-note-without-the-membership

Read it, then do this here, and nothing else:

1. Add a "How this repository is maintained" section as the last section of
   README.md, creating it if there is not one, from the **affiliating** template
   that page gives.
2. State who maintains this repository. The default is that it is written and
   maintained by people; depart from that only where the tree itself shows
   otherwise. Say what the supervision does not cover.
3. Keep the paragraph that names the Eunoia ecosystem as one this repository
   works with and says this repository is **not held to** its policy: it is not
   checked against it, it adopts none of it, and an assessment of this repository
   published by a tool in that ecosystem is that tool's own and not this
   repository's.

Add no workflow file, run no checker, declare membership of nothing, and change
no file other than README.md. This repository is **not** joining the Eunoia
ecosystem, and the section must not say or imply that it is: naming it and
joining it are different claims, and only the first is being made. Where the page
and this prompt disagree, the page is right.

Leave the work staged and not committed: `git add README.md` and stop there, so
a maintainer reviews a diff rather than a history. Then say, in one paragraph:
what the section now claims about who maintains this repository, and what you
could not establish from the tree and left for a person to write.
AFFIL_PROMPT_END

read -r -d '' ASSOC_PROMPT <<'ASSOC_PROMPT_END' || true
**First, one question, and stop if the answer is no.** Is this repository solely
the runner's to speak for? This writes a footing onto its maintenance page, which
is a claim about what the repository holds itself to. If the tree is shared -- an
organisation, a community, other maintainers with a say -- **that is not the
runner's alone to decide, and commit access does not make it so.** In that case:
change nothing, say which repository this looks like and who else would have to
agree, and suggest `eo_join --soft`, which claims nothing.

This repository is taking the **associate** footing: it holds itself to the
Eunoia ecosystem's shared repository policy, and **owes that ecosystem nothing.**

**Read that second half carefully, because it is the whole of the footing.** An
associate is not a quieter member. The obligation is one the repository imposes
on *itself* and answers to by itself; nobody here is owed it. The check is run
and the result is printed as a measurement, not a shortfall -- a failure is
nobody's fault, no note asks anyone to fix it, and it counts toward nothing.

**The marker is read strictly anyway, and that is not a contradiction.**
Strictness here is not an obligation being enforced. It is the difference
between a claim somebody can check and a word: a footing naming itself and no
obligation leaves a reader nothing to hold it to, and leaves the checker nothing
to measure against.

One page defines this footing and it is the authority:

  https://github.com/ajreynol/kanon/blob/main/docs/policy.md#the-footings

Read it, then do what it says, here. Where that page and this prompt disagree,
the page is right:

1. In `docs/maintenance.md`, creating that page if there is not one, record the
   footing. The line names it and says what this repository holds **itself** to,
   and the paragraph under it gives this repository's own reason:

       **Footing:** `associate` — held to the Eunoia ecosystem's shared
       repository policy by this repository's own choice, and owing that
       ecosystem nothing.

   Then say, in the same paragraph, **why** this is not on the front page: it is
   not published, it is one person's working tree, a declaration would oversell
   what is in it. That reason is yours and nobody grades it.
2. **Add no membership declaration to README.md**, and remove one if it is
   there. A tree that records this footing and also declares membership is
   making two different claims, and the checker names the pair.
3. Add the CI workflow the policy page gives, so the check can run and print a
   result. **What it prints is a measurement.** Nothing about a red run obliges
   this repository to anything.
4. Run the same checker revision and command the workflow uses, and say what it
   reports. Report which revision you checked. Do not substitute the latest
   checkout for a pinned revision, and do not claim a local run establishes CI.

The footing line must say the repository **is held to** the policy and must not
also say it is not; a marker carrying both says nothing. A tree that is held to
none of this is **not** an associate -- it keeps the independent note that
`eo_join --soft` writes. Change nothing the check does not ask for, and add no
file it does not ask for.

Leave the work staged and not committed: `git add` what you changed and stop
there, so a maintainer reviews a diff rather than a history. Then say, in one
paragraph: what the marker now claims, what reason you recorded and whether it
came from the runner or from you, what the check reports, and anything the
policy asked for that does not fit this repository.
ASSOC_PROMPT_END

if [ "$SOFT" = 1 ]; then PROMPT=$SOFT_PROMPT; fi
if [ "$SOFT" = 1 ] && [ "$AFFIL" = 1 ]; then PROMPT=$AFFIL_PROMPT; fi
if [ "$SOFT" = 0 ] && [ "$AFFIL" = 1 ]; then
  echo "eo_join: --affiliated is a form of --soft; pass both" >&2; exit 2
fi
if [ "$ASSOC" = 1 ] && [ "$SOFT" = 1 ]; then
  echo "eo_join: --associate holds this tree to the policy and --soft claims nothing; pass one" >&2
  exit 2
fi
if [ "$ASSOC" = 1 ]; then PROMPT=$ASSOC_PROMPT; fi

if [ "$SHOW" = 1 ]; then printf '%s\n' "$PROMPT"; exit 0; fi

command -v "$AGENT" >/dev/null 2>&1 || {
  echo "eo_join: $AGENT is not on PATH" >&2; exit 127; }

if ! ROOT=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "eo_join: not in a git repository -- run this in a checkout of the" >&2
  echo "         repository that is joining." >&2
  exit 2
fi

WHAT=joining
if [ "$SOFT" = 1 ]; then WHAT="the note only, independent"; fi
if [ "$SOFT" = 1 ] && [ "$AFFIL" = 1 ]; then WHAT="the note only, affiliated"; fi
if [ "$ASSOC" = 1 ]; then WHAT="the associate footing"; fi
echo "-- eo_join: $(basename "$ROOT") ($ROOT), $WHAT, via $AGENT" >&2

cd "$ROOT"
if [ "$AGENT" = codex ]; then
  if [ "$PRINT" = 1 ]; then exec codex exec "$PROMPT"; else exec codex "$PROMPT"; fi
else
  if [ "$PRINT" = 1 ]; then exec claude -p "$PROMPT"; else exec claude "$PROMPT"; fi
fi
