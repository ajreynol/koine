#!/usr/bin/env python3
"""eo_listen -- print incoming discussion without changing any checkout.

Read local discussion files and print complete topics whose opening To field
names this repository. No assistant, network access or sibling imports.
"""

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import urlsplit

REGISTER = Path("scripts/ecosystem/ecosystem.json")


def git(path, *args):
    env = dict(os.environ)
    for key in ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE",
                "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES"):
        env.pop(key, None)
    env["GIT_NO_LAZY_FETCH"] = "1"
    return subprocess.run(
        ["git", "--no-optional-locks", "-c", "core.fsmonitor=false",
         "-C", str(path), *args], env=env, capture_output=True,
        text=True, encoding="utf-8", errors="replace")


def checkout(path):
    result = git(path, "rev-parse", "--show-toplevel")
    if result.returncode == 0:
        return Path(result.stdout.rstrip("\n")).resolve()
    return None


def url_key(value):
    if not isinstance(value, str):
        return None
    if "://" in value:
        url = urlsplit(value)
        host, path = url.hostname, url.path
    else:
        match = re.fullmatch(r"(?:[^/@]+@)?([^/:]+):(.+)", value)
        if not match:
            return None
        host, path = match.groups()
    return (host.casefold(), path.strip("/").removesuffix(".git").casefold()) if host else None


def identity(path, mapped, known):
    names = mapped.intersection(known) if known else set(mapped)
    if not names:
        remote = git(path, "config", "--get-regexp", r"^remote\..*\.url$")
        urls = {url_key(line.split(None, 1)[1]) for line in remote.stdout.splitlines()
                if len(line.split(None, 1)) == 2}
        urls.discard(None)
        for name, entry in known.items():
            directory = str(entry.get("repo") or name).rsplit("/", 1)[-1]
            if (path.name.casefold() in (name.casefold(), directory.casefold())
                    or url_key(entry.get("url")) in urls):
                names.add(name)
    if len(names) > 1:
        raise ValueError(f"ambiguous repository identity at {path}: {', '.join(sorted(names))}")
    return next(iter(names), None)


def read_map(map_path, paths, notes, known=None):
    for number, line in enumerate(map_path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        pair = line.split(None, 1)
        if len(pair) != 2:
            raise ValueError(f"{map_path}:{number}: expected ID PATH")
        name, location = pair
        if known and name not in known:
            continue  # Children correspond through their parent.
        top = checkout(Path(location).expanduser())
        if top:
            paths.setdefault(top, set()).add(name)
        else:
            notes.append(f"Mapped checkout unavailable: {name} at {location}")


def discover(current):
    paths = {current: set()}
    notes = []
    roots = [Path(p).expanduser().resolve()
             for p in os.environ.get("ANOIEU_REPOS", "").split(os.pathsep) if p]
    roots.extend([current.parent, Path.home()])
    for root in dict.fromkeys(roots):
        if not root.is_dir():
            notes.append(f"Search directory unavailable: {root}")
            continue
        for candidate in [root, *sorted(root.iterdir())]:
            if candidate.is_dir() and (candidate / ".git").exists():
                top = checkout(candidate)
                if top:
                    paths.setdefault(top, set())
                else:
                    notes.append(f"Cannot inspect Git checkout: {candidate}")

    # An explicit map can locate the register itself, outside the search roots.
    mapping = os.environ.get("ANOIEU_REPOS_FILE")
    if mapping:
        read_map(Path(mapping).expanduser(), paths, notes)
    register = next((p / REGISTER for p in paths if (p / REGISTER).is_file()), None)
    known = {}
    if register:
        data = json.loads(register.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError(f"{register}: expected a register object")
        known = {name: entry for name, entry in data.items()
                 if isinstance(entry, dict) and entry.get("status")
                 and entry["status"] != "child"}
        if sum(entry["status"] == "president" for entry in known.values()) != 1:
            raise ValueError(f"{register}: expected exactly one president")

    if register and not mapping:
        map_path = register.parents[2] / "scripts/repos.local"
        if map_path.exists():
            read_map(map_path, paths, notes, known)

    us = identity(current, paths[current], known) or current.name
    peers = []
    located = {us}
    for path, mapped in paths.items():
        name = identity(path, mapped, known)
        if not known:
            name = name or path.name
        if path == current or name == us or name is None:
            continue
        located.add(name)
        peers.append((name, path))
    if register:
        notes.append(f"Register: {register}")
        notes.extend(f"Not checked out: {name}" for name in sorted(known.keys() - located))
    else:
        notes.append("No register found: nearby repository names are unverified; "
                     "ecosystem coverage and missing repositories are unknown.")
    if not peers:
        notes.append("No other tool of this ecosystem is checked out in the search locations.")
    return us, sorted(peers), notes


def addressed_topics(text, recipient):
    """Yield (line number, original text) for matching top-level topics.

    A new level-one or level-two heading ends a topic. Fenced examples and
    blockquotes cannot start topics; replies and body mentions cannot address
    them. To is the first field in the discussion format.
    """
    lines = text.splitlines(keepends=True)
    sections = []
    fence = None
    for index, line in enumerate(lines):
        if fence:
            if re.fullmatch(r" {0,3}" + re.escape(fence[0]) +
                            "{" + str(len(fence)) + r",}[ \t]*", line.rstrip("\r\n")):
                fence = None
            continue
        opening = re.match(r"^ {0,3}(`{3,}|~{3,})", line)
        if opening:
            fence = opening.group(1)
            continue
        if re.match(r"^ {0,3}#{1,2}[ \t]+", line):
            topic = re.match(r"^ {0,3}##[ \t]+D[0-9]+(?:[ \t]|$)", line)
            sections.append((index, bool(topic)))
    sections.append((len(lines), False))
    for (start, topic), (end, _) in zip(sections, sections[1:]):
        if not topic:
            continue
        first = next((line.strip() for line in lines[start + 1:end] if line.strip()), "")
        to = re.fullmatch(r"(?:\*\*To:\*\*|To:)[ \t]*(.*)", first)
        if to and recipient in {name.strip() for name in to.group(1).split(",")}:
            yield start + 1, "".join(lines[start:end]).rstrip("\r\n")


def listen(us, peers, notes):
    count = 0
    read = 0
    failed = False
    for name, path in peers:
        discussion = path / "docs/discussion.md"
        try:
            text = discussion.read_text(encoding="utf-8")
        except FileNotFoundError:
            notes.append(f"No discussion file: {discussion}")
            continue
        except (OSError, UnicodeError) as exc:
            notes.append(f"Cannot read {discussion}: {exc}")
            failed = True
            continue
        read += 1
        for line, topic in addressed_topics(text, us):
            if count:
                print()
            print(f"# {name} — {discussion}:{line}\n")
            print(topic)
            count += 1
    if not count:
        print(f"No topics addressed to {us} in the discussion files read.")
    print(f"-- eo_listen: {count} topic(s) addressed to {us}; "
          f"read {read} discussion file(s).", file=sys.stderr)
    for note in notes:
        print(f"-- {note}", file=sys.stderr)
    return 1 if failed else 0


def main():
    parser = argparse.ArgumentParser(
        description="eo_listen -- print discussion topics addressed to your repository "
                    "in the Eunoia ecosystem.\n\nRun it in your own repository. "
                    "Reads local checkouts without fetching or changing files. "
                    "Searches beside this checkout, under $ANOIEU_REPOS and $HOME, "
                    "and through the president's scripts/repos.local map. "
                    "Prints complete matching topics, including replies, to stdout. "
                    "Missing sources and coverage go to stderr. Requires Python 3 and Git; "
                    "launches no assistant.",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.parse_args()
    try:
        current = checkout(Path.cwd())
        if current is None:
            parser.error("not in a git repository -- run this in the repository being addressed")
        return listen(*discover(current))
    except (OSError, ValueError) as exc:
        print(f"eo_listen: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
