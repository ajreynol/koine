#!/usr/bin/env python3
"""eo_status -- who is in the Eunoia ecosystem, and on what footing.

WHERE: run this **in the repository that holds the register** -- the tree with
scripts/ecosystem/ecosystem.json in it, which today is kanon and only kanon.
That file is the ground truth for who is in this ecosystem; this reads it and
prints it.

**Anywhere else it is an offline command, and may be out of date.** That is
the intended way to use it away from the president's tree: the register is
baked in when this file is installed, and a run says which commit and date the
snapshot came from. Re-installing refreshes it. What it will not do is go
looking -- no sibling checkout, no clone, no cache -- because a register found
somewhere unnamed is a claim about who is in this ecosystem with no way to say
how current it is.

**It never writes.** A footing is a decision somebody made, and no program
takes one. --check reports what is structurally wrong with the file and fixes
nothing.

**One file, no imports of its own.** It is installed by copying it onto a path,
so anything it needed from beside it in the koine tree would not be there. This
carried a sibling module until 2026-09-17 and broke exactly that way the first
time somebody ran the installed copy.
"""

import argparse
import datetime
import json
import os
import subprocess
import sys

#: The register, relative to the root of the repository that holds it. Its
#: presence is what makes a directory the one this may be run in.
#: Filled in when this file is installed, from the president's tree. Away from
#: that tree this command is **offline and may be out of date**, which is fine
#: and is the point: it works anywhere. What is not fine is a stale answer
#: presented as a current one, so every run that falls back to this says which
#: commit and date it came from.
EMBEDDED = None
EMBEDDED_FROM = ""

REGISTER = os.path.join("scripts", "ecosystem", "ecosystem.json")
CHECKOUTS = os.path.join("scripts", "ecosystem", "checkouts.json")

#: Every footing the policy defines. A value outside this set is a register
#: that has drifted from the page that defines it, which `--check` reports and
#: this module does not silently accept.
FOOTINGS = {"member", "associate", "candidate", "foundation", "president",
            "child", "outsider"}

WHERE = ("Run it at the root of the repository that holds the register -- the tree\n"
         "with scripts/ecosystem/ecosystem.json in it, which today is the\n"
         "president's -- and it reads the live register.\n\n"
         "Run it anywhere else and it is offline: it uses the snapshot baked in\n"
         "when this file was installed, names the commit and date that came\n"
         "from, and may be out of date. Re-install to refresh it. It never goes\n"
         "looking for a register elsewhere, and never presents a snapshot as\n"
         "the live one.")


def holds_register(root):
    """Is this the repository the register lives in?"""
    return bool(root) and os.path.isfile(os.path.join(root, REGISTER))


def require(root="."):
    """The register, and how current it is: `(data, provenance)`.

    **Live beats snapshot beats refusal**, in that order and never silently.
    Standing in the tree that holds the register, that file is read and the run
    is authoritative. Anywhere else, the snapshot taken at install time is used
    and the run says where it came from and when. With neither, this refuses
    rather than guessing -- there is no third place to look, by design.
    """
    root = os.path.abspath(os.path.expanduser(root))
    if holds_register(root):
        with open(os.path.join(root, REGISTER), encoding="utf-8") as handle:
            return json.load(handle), f"live, from {root}"
    if EMBEDDED is not None:
        return EMBEDDED, f"a snapshot taken at install time, {EMBEDDED_FROM}"
    raise SystemExit(
        f"-- refused: {root} does not hold {REGISTER}, and this copy carries no\n"
        f"   snapshot -- it was run out of a source tree rather than installed.\n\n"
        f"{WHERE}")


def checkouts(root="."):
    """The recorded checkout locations, where the tree has them. `{}` if not."""
    path = os.path.join(os.path.abspath(os.path.expanduser(root)), CHECKOUTS)
    if not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def entries(data):
    """The register's tools, as `(id, entry)`. Anything else is not a tool.

    The file carries prose alongside the entries -- a key whose value is a list
    of strings documenting the footings, for instance. A tool is a mapping with
    a `status`, and nothing here infers one that is missing.
    """
    return [(k, v) for k, v in data.items()
            if isinstance(v, dict) and "status" in v]


def problems(data):
    """What is wrong with the register, structurally. Offline, and no opinions.

    It never says a footing is the wrong one to have given somebody: that is a
    decision and not a defect. It says a footing is not one the policy defines,
    an entry is missing what every entry carries, or two entries claim the same
    repository -- each of which is a fact about the file.
    """
    bad = []
    seen = {}
    for name, entry in entries(data):
        footing = entry["status"]
        if footing not in FOOTINGS:
            bad.append(f"{name}: footing `{footing}` is not one the policy defines")
        if footing == "child":
            if not entry.get("parent"):
                bad.append(f"{name}: a child records no parent")
        elif not entry.get("url"):
            bad.append(f"{name}: no url, so nothing can be checked against it")
        repo = entry.get("url") or entry.get("repo")
        if repo:
            if repo in seen:
                bad.append(f"{name}: claims {repo}, which {seen[repo]} also claims")
            seen[repo] = name
    return bad


# --- the checkouts on this machine, and what the checker says about them ------
#
# Everything below reads the tree the register is in. That is not a limitation
# worked around: the caller already had to be standing there, so the mapping
# file and the exceptions file are local too, and nothing here goes looking
# outside the tree it was pointed at.

REPOS_FILE = os.path.join("scripts", "repos.local")


def locate(repo, root="."):
    """Where a tool is checked out on this machine, or "".

    The mapping file first, because it is a person's answer and beats a guess;
    then $ANOIEU_REPOS, then beside the register's tree, then $HOME. The id
    comes from the register, never from a path somebody typed.
    """
    root = os.path.abspath(os.path.expanduser(root))
    mapping = os.path.join(root, REPOS_FILE)
    if os.path.isfile(mapping):
        with open(mapping, encoding="utf-8") as handle:
            for line in handle:
                line = line.split("#", 1)[0].strip()
                parts = line.split(None, 1)
                if len(parts) == 2 and parts[0] == repo:
                    path = os.path.expanduser(parts[1].strip())
                    if os.path.isdir(path):
                        return path
    roots = [p for p in os.environ.get("ANOIEU_REPOS", "").split(os.pathsep) if p]
    for base in roots + [os.path.dirname(root), os.path.expanduser("~")]:
        candidate = os.path.join(base, repo)
        if os.path.isdir(candidate):
            return candidate
    return ""


def _git(*args, cwd=None):
    out = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else ""


def age(path):
    """How long since that checkout's last commit. `?` where it is not git."""
    when = _git("log", "-1", "--format=%cI", cwd=path)
    if not when:
        return "?"
    then = datetime.datetime.fromisoformat(when)
    days = (datetime.datetime.now(then.tzinfo) - then).days
    return "today" if days == 0 else f"{days}d"


def channel(where, us):
    """Whether that tree keeps a channel, and whether anything in it is ours.

        -          no checkout here, so nothing could be read
        none       they keep no docs/discussion.md
        yes        they keep one, and nothing in it is addressed to us
        N for us   N topics name us in their `To:`

    **Three states, not two.** *They have no channel* and *they have one and
    nothing in it is for us* are different facts about a repository, and
    collapsing them would hide which. Read from their correspondence rather
    than their code -- so this counts and never opens one. Acting on a topic
    needs a human who named it, and a column in a table is not that.
    """
    if not where or not us:
        return "-"
    path = os.path.join(where, "docs", "discussion.md")
    if not os.path.isfile(path):
        return "none"
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        return "-"
    addressed = 0
    for block in text.split("\n## ")[1:]:
        # The fields sit under the heading, past the blank line after it, so
        # the whole head of the block is scanned rather than its first
        # paragraph -- which is the title and nothing else.
        for line in block.splitlines()[:12]:
            if line.startswith("**To:**") and us in line:
                addressed += 1
                break
    if not addressed:
        return "yes"
    return f"{addressed} for us"


def checker(root="."):
    """The policy checker to run, and where it came from. `("", why)` if none.

    **The checker is anoieu's and is not ours to carry.** A shim in the tree we
    are standing in is preferred, because that tree already decided which
    revision it trusts; a sibling anoieu checkout is the fallback for a machine
    that has one.
    """
    root = os.path.abspath(os.path.expanduser(root))
    shim = os.path.join(root, "scripts", "policy_check.py")
    if os.path.isfile(shim):
        return shim, "the shim in this tree, which picks the revision it trusts"
    for base in (os.environ.get("ANOIEU", ""), os.path.dirname(root)):
        if not base:
            continue
        direct = os.path.join(base if base.endswith("anoieu") else
                              os.path.join(base, "anoieu"),
                              "scripts", "policy_check.py")
        if os.path.isfile(direct):
            return direct, direct
    return "", "no policy checker found: no shim here and no anoieu checkout"


def verdict(path, checker_path):
    """What the checker says about a checkout: `(verdict, reasons)`.

    Failing **checks** are counted, not their detail lines: one check reporting
    three things is one thing wrong, and saying `3 failing` overstates it.

    **A count is not a judgement.** What it means depends on the footing, and
    that is the reader's to apply: a number against a tool that owes this
    ecosystem nothing is a measurement, and against a member it is a shortfall.
    Nothing here decides which.
    """
    if not checker_path:
        return "unverified", ["no checker"]
    out = subprocess.run([os.sys.executable, checker_path, "--root", path],
                         capture_output=True, text=True)
    failed, detail, inside = [], [], False
    for line in out.stdout.splitlines():
        if line.startswith("FAIL "):
            failed.append(line[5:].strip())
            detail.append(failed[-1])
            inside = True
        elif inside and line.startswith("     "):
            detail.append(line.strip())
        else:
            inside = False
    if out.returncode not in (0, 1) or (out.returncode == 1 and not failed):
        return "unverified", [out.stderr.strip() or out.stdout.strip()
                              or "the checker did not report a result"]
    return (f"{len(failed)} failing" if failed else "ok"), detail


#: Printed in this order, because it is the order somebody reads the ecosystem
#: in: the office, then who is held to the policy, then who is not, then the
#: things that are not repositories at all.
#: Footings that owe this ecosystem nothing. A failing count against one of
#: these is a measurement rather than a shortfall, and the table says `tracked`
#: rather than `failing` so the two are never read as the same thing.
#: Only the associate. The policy's sentence is precise -- *a member's number
#: is a shortfall; an associate's is a measurement* -- and a candidate is not
#: named in it, so this does not extend the wording on its own. Whether it
#: should is a question for the office, not for a renderer.
OWES_NOTHING = {"associate"}

#: What each footing means, printed under --verbose rather than in the table:
#: a key beside every row would be noise, and absent entirely it is a table of
#: words somebody has to go and look up.
MEANS = {
    "president": "holds the office, for this stretch",
    "member": "declares it on the front page, and a green check on every push",
    "associate": "holds itself to the policy; owes this ecosystem nothing",
    "candidate": "addressed by the policy, and owes nothing",
    "foundation": "this ecosystem is downstream of it; owes nothing, ever",
    "outsider": "tracked, and never proposed for promotion",
    "child": "not a repository: reached through its parent",
}


def main():
    parser = argparse.ArgumentParser(
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="eo_status -- who is in the Eunoia ecosystem, and on what "
                    "footing.\n\n" + WHERE,
        epilog="A footing is a decision somebody made. Nothing here takes one, "
               "and nothing here writes to the register.")
    parser.add_argument("--root", metavar="DIR", default=".",
                        help="the repository holding the register (default: here)")
    parser.add_argument("--check", action="store_true",
                        help="report what is structurally wrong with the register")
    parser.add_argument("--children", action="store_true",
                        help="include child projects, which are not repositories")
    parser.add_argument("--no-policy", dest="policy", action="store_false",
                        help="skip the checker, which is what makes a run slow")
    parser.add_argument("--verbose", action="store_true",
                        help="say what each failing check reported")
    args = parser.parse_args()

    try:
        data, provenance = require(args.root)
    except SystemExit as exc:
        print(exc, file=sys.stderr)
        return 2

    live = provenance.startswith("live")
    if not live:
        print(f"-- offline: {provenance}")
        print("--   re-install to refresh it, or run in the president's tree "
              "for the live register")

    tools = entries(data)
    if args.check:
        bad = problems(data)
        for line in bad:
            print(f"   {line}", file=sys.stderr)
        print(f"-- {len(tools)} entries, {len(bad)} problem(s) -- {provenance}")
        if not bad:
            print("-- the register is well formed. Whether each footing is the "
                  "right one is a decision, and not checkable")
        return 1 if bad else 0

    checker_path, why = ("", "")
    if args.policy and live:
        checker_path, why = checker(args.root)
        if not checker_path:
            print(f"-- policy column unavailable: {why}", file=sys.stderr)

    us = os.path.basename(_git("rev-parse", "--show-toplevel",
                               cwd=os.path.abspath(args.root)) or "")

    rows = []
    for name, entry in tools:
        footing = entry["status"]
        if footing == "child" and not args.children:
            continue
        where = "" if footing == "child" else (
            locate(entry.get("repo") or name, args.root) if live else "")

        if footing == "child":
            policy, moved, detail = "-", "-", []
            where = entry.get("parent", "")
        elif footing == "foundation":
            policy, moved, detail = "-", "-", []
        elif not where:
            policy, moved, detail = ("no checkout" if live else "-"), "-", []
        else:
            said, detail = verdict(where, checker_path) if checker_path else ("-", [])
            # A count against a tool that owes this ecosystem nothing is a
            # measurement; against one that owes the policy it is a shortfall.
            # Printing both in the same word would invite the conclusion the
            # footing refuses, so the word differs.
            if said.endswith("failing") and footing in OWES_NOTHING:
                said = said.replace("failing", "tracked")
            policy, moved = said, age(where)

        rows.append((name, footing, policy, channel(where, us), moved,
                     where, entry.get("short") or entry.get("what") or "", detail))

    widths = [max(len(str(r[i])) for r in rows) if rows else 0 for i in range(7)]
    header = ("tool", "status", "policy", "channel", "moved", "where", "purpose")
    widths = [max(w, len(h)) for w, h in zip(widths, header)]
    print("  ".join(h.ljust(w) for h, w in zip(header, widths)).rstrip())
    for row in rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(row[:7], widths)).rstrip())
        if args.verbose:
            for line in row[7]:
                print(f"     {line}")

    hidden = sum(1 for _, e in tools if e["status"] == "child") if not args.children else 0
    print(f"\n-- {len(rows)} shown, {provenance}"
          + (f"; {hidden} child project(s) not listed, --children shows them"
             if hidden else ""))
    if args.policy and checker_path:
        print("-- a count is a measurement against a tool that owes this "
              "ecosystem nothing,")
        print("   and a shortfall against one that does. The footing column "
              "says which")
    print("-- the register is the ground truth: this printed it and changed "
          "nothing")
    return 0


if __name__ == "__main__":
    sys.exit(main())
