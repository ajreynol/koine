#!/usr/bin/env python3
"""eo_cvc5_check_dokimasia -- investigate and fix cvc5 proof-production gaps.

Self-contained because install_eo copies each command as a single file.
The launcher reads paths and builds a prompt; only the selected agent does work.
"""

import argparse
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

COMMAND = 'eo_cvc5_check_dokimasia'
TOOL = 'dokimasia'
NUMBER_KIND = ''
SOURCE = 'https://github.com/ajreynol/dokimasia'
SOURCE_PREFIX = 'dokimasia'
SUMMARY = 'investigate and fix cvc5 proof-production gaps'
TASK = """Start from Dokimasia's observation database, not its tooling.
Read `{tool}/bug_db/README.md`, then `{tool}/bug_db/bugs.md` for the recorded
observations and `{tool}/bug_db/bugs.json` for their records; the archived runs in
`{tool}/bug_db/runs/` hold each observation's evidence, source revision and
coverage, keyed by id. Select the open entries (no `closed_*` field) owned by
cvc5. Those entries are the worklist; group them by check code and entity rather
than working one row at a time. `{tool}/docs/README.md` defines each check, the
proof-hygiene rules and the safe-mode contract, and
`{tool}/dokimasia_analyzer/README.md` sets the evidence bar. A recorded
observation is not necessarily a confirmed bug, and its dates are ingestion
dates, not fresh confirmation. For each group, re-read the cited cvc5 code at
this revision and decide whether the claim still holds. Static observations alone
do not establish a reachable bug or incomplete proof: reproduce behavioral claims
with concrete inputs and actual output, including proof-completeness checking
where relevant. Distinguish analyzer mistakes from cvc5 defects. Fix confirmed
cvc5 defects at their cause, add focused regression coverage, and run the
relevant cvc5 tests. Report observations that no longer hold, with the evidence,
rather than closing them; closure is Dokimasia's own workflow. Do not weaken
safe-mode guarantees or suppress observations.
{analysis}

**Leave the work staged and not committed**: `git add` what you changed and
stop there, so a person reviews a diff rather than a history. Stage only your
changes, preserving any changes already staged when the run began."""
LOCAL_ANALYSIS = """Run the analyzer only to confirm a fix, with
`{tool}/scripts/dokimasia_analyzer --cvc5` on this root, `--no-update`, and
`--dump` in a temporary directory outside both repositories; never append.
"""


def positive_number(value):
    if not re.fullmatch(r"[1-9][0-9]*", value):
        raise argparse.ArgumentTypeError("N must be a positive issue or PR number")
    return value


def main():
    parser = argparse.ArgumentParser(
        prog=COMMAND, allow_abbrev=False,
        usage="%(prog)s [options]" + (" N" if NUMBER_KIND else ""),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=f"{COMMAND} -- {SUMMARY}.\n\n"
                    "An Eunoia ecosystem prompt command. Run it in a cvc5 repository;\n"
                    "the agent starts at the checkout root on the current branch.\n"
                    "Read the tool's charter, investigate, and leave the result locally.",
        epilog="--show-prompt works without cvc5 or an agent installed.\n"
               "--tool-root opts into local tool context and analyzer use.\n"
               "No tool is discovered by default.\n"
               "No launcher switches branches, pulls, runs analyses, or writes files.")
    if NUMBER_KIND:
        parser.add_argument("number", metavar="N", type=positive_number,
                            help=f"the cvc5 {NUMBER_KIND} number (required)")
    parser.add_argument("--tool-root", metavar="DIR", help="optionally use a local tool checkout containing README.md")
    parser.add_argument("--codex", dest="agent", action="store_const", const="codex",
                        help="select codex instead of claude")
    parser.add_argument("--claude", dest="agent", action="store_const", const="claude",
                        help="select claude (the default)")
    parser.set_defaults(agent="claude")
    parser.add_argument("--print", dest="noninteractive", action="store_true",
                        help="run the agent non-interactively and print the result")
    parser.add_argument("--show-prompt", action="store_true", help="print the prompt and launch nothing")
    parser.add_argument("--push", action="store_true", help="refused: these runs keep their results local")
    args = parser.parse_args()
    if args.push:
        parser.error("--push is refused: upstream delivery remains a person's decision")

    try:
        git = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True)
    except FileNotFoundError:
        git = None
    root = Path(git.stdout.strip()).resolve() if git and git.returncode == 0 else Path.cwd()
    is_cvc5 = (git is not None and git.returncode == 0
               and (root / "configure.sh").is_file() and (root / "src/theory").is_dir())
    if not is_cvc5 and not args.show_prompt:
        parser.error("run this in a cvc5 Git checkout (configure.sh and src/theory/ are required)")
    tool = Path(args.tool_root).expanduser().resolve() if args.tool_root is not None else None
    if tool is not None:
        if not (tool / "README.md").is_file() and not args.show_prompt:
            parser.error(f"no {TOOL} charter found at {tool / 'README.md'}; "
                         "--tool-root must name its README.md directory")
        context = f"Read `{tool / 'README.md'}` first; it is {TOOL}'s charter."
        context += (" Use the tool checkout as a source of instructions and analysis, "
                    "without modifying its code, database, ledger, or baselines.")
    else:
        context = (f"Read {SOURCE} through read-only GitHub access, beginning with "
                   f"`{SOURCE_PREFIX}/README.md`. Record the source revision and use it "
                   f"consistently. References below beginning with `{SOURCE_PREFIX}/` "
                   "name paths in that published repository. If required evidence is "
                   "unavailable, report the limitation; do not invent findings or treat "
                   "unread records as an empty worklist.")
    if not is_cvc5:
        context += " This preview is outside a cvc5 checkout; a real run requires one."
    task = TASK.format(root=root, tool=tool if tool is not None else SOURCE_PREFIX,
                       analysis=LOCAL_ANALYSIS.format(tool=tool) if tool is not None else "")
    prompt = f"""You are working in the cvc5 checkout at `{root}`, following {TOOL}'s charter.
{context} Read cvc5's own contributor instructions and relevant tests. Keep the
current branch and inspect existing changes before doing anything; preserve work
that was already here. Do not switch branches, pull, reset, or stash this tree.

{task}

Leave the source database, ledger and baselines unchanged. Put temporary output
and builds in temporary directories outside the target repository. Report the source revisions,
commands, actual results, fixes or review findings, and anything still unverified.
Do not commit, push, open a pull request, post a review or comment, or send anything
upstream. A person decides what to publish.
"""
    # Keep interpolated paths intact, including their spaces.
    prompt = prompt.strip() + "\n"
    if args.show_prompt:
        print(prompt, end="")
        return 0
    executable = shutil.which(args.agent)
    if executable is None:
        print(f"{COMMAND}: {args.agent} is not on PATH", file=sys.stderr)
        return 127
    argv = [args.agent]
    if args.noninteractive:
        argv.append("exec" if args.agent == "codex" else "-p")
    argv.append(prompt)
    charter = f"; charter: {tool / 'README.md'}" if tool is not None else ""
    print(f"-- {COMMAND}: {root}, via {args.agent}{charter}", file=sys.stderr)
    os.chdir(root)
    os.execv(executable, argv)


if __name__ == "__main__":
    sys.exit(main())
