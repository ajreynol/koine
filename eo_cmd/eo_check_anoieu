#!/usr/bin/env python3
"""eo_check_anoieu -- investigate and fix Eunoia signature and semantics defects.

Self-contained because install_eo copies each command as a single file.
The launcher reads paths and builds a prompt; only the selected agent does work.
"""

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys

COMMAND = 'eo_check_anoieu'
TOOL = 'anoieu'
SUMMARY = 'investigate and fix Eunoia signature and semantics defects'
TASK = """Start from Anoieu's bug database, not its tooling. Read
`{tool}/bug_db/README.md` and `{tool}/bug_db/reporting-policy.md`, then
`{tool}/bug_db/bugs.md` for the open findings and `{tool}/bug_db/bugs.json` for
their records. Establish which project this repository is from its remote,
documentation or `anoieu.json`, and select the open entries (no `closed_*` field)
whose `owner` names it, including joint owners such as `a+b`. Those entries are
the worklist. For each, read its `where`, `found_at`, code and note; static
findings cite a source location, and fuzzer findings cite a committed reproducer
under `{tool}/tests/fuzz/`. A recorded finding is a candidate, not proof of a
bug, and its dates are ingestion dates, not fresh reproduction. Check whether the
claim still holds at this revision: re-read the cited source, replay the
reproducer with the checkers it names, and record the exact commands and actual
output. For a static code, `{tool}/anoieu_analyzer/checks.md` defines what the
check asserts. Reproduce and isolate each confirmed defect in this repository,
fix its cause, add a focused regression, and rerun the reproducer and relevant
project tests before and after. Report findings that no longer hold, with the
evidence, rather than closing them; closure is the database owner's workflow.
Distinguish target defects from analysis-tool or external checker defects, and
report those without changing another tree. If no open entry names this
repository, report that and stop; do not substitute a fresh analysis for an
empty worklist. Run the analyzer (`{tool}/anoieu_analyzer/usage.md`) only to
confirm a fix, with absolute paths, this target as the working directory and its
own `anoieu.json` or documented profiles, and never the database updater.
This is signature and semantics work, not the optional ecosystem policy check.

**Leave the work staged and not committed**: `git add` what you changed and
stop there, so a person reviews a diff rather than a history. Stage only your
changes, preserving any changes already staged when the run began."""


def locate_tool(root, explicit):
    """Explicit settings win, even when invalid; never substitute another tree."""
    selected = explicit or os.environ.get(TOOL.upper() + "_ROOT")
    if selected:
        return Path(selected).expanduser().resolve()
    roots = [Path(p).expanduser() for p in
             os.environ.get("ANOIEU_REPOS", "").split(os.pathsep) if p]
    roots += [root.parent, Path.home()]
    for search in roots:
        for candidate in (search / TOOL, search):
            # A search root's own README is not necessarily this tool's charter.
            if candidate == search and candidate.name != TOOL:
                continue
            if (candidate / "README.md").is_file():
                return candidate.resolve()
    return None


def main():
    parser = argparse.ArgumentParser(
        prog=COMMAND, allow_abbrev=False,
        usage="%(prog)s [options]",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=f"{COMMAND} -- {SUMMARY}.\n\n"
                    "An Eunoia ecosystem prompt command. Run it in the repository to check;\n"
                    "the agent starts at the checkout root on the current branch.\n"
                    "Read the tool's charter, investigate, and leave the result locally.",
        epilog="--show-prompt works without a Git checkout, the tool, or an agent installed.\n"
               "Tool discovery: --tool-root, $" + TOOL.upper() + "_ROOT, then\n"
               "$ANOIEU_REPOS (colon-separated), siblings of the target repository,\n"
               "and $HOME. --tool-root names the charter directory.\n"
               "No launcher switches branches, pulls, runs analyses, or writes files.")
    parser.add_argument("--tool-root", metavar="DIR", help="directory containing the tool's README.md")
    parser.add_argument("--codex", dest="agent", action="store_const", const="codex",
                        help="select codex instead of claude")
    parser.add_argument("--claude", dest="agent", action="store_const", const="claude",
                        help="select claude (the default)")
    parser.set_defaults(agent="claude")
    parser.add_argument("--print", dest="noninteractive", action="store_true",
                        help="run the agent non-interactively and print the result")
    parser.add_argument("--show-prompt", action="store_true", help="print the prompt and launch nothing")
    parser.add_argument("--push", action="store_true", help="refused: these runs keep their results local")
    args = parser.parse_args()
    if args.push:
        parser.error("--push is refused: this tool's charter leaves upstream delivery to a person")

    try:
        git = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True)
    except FileNotFoundError:
        git = None
    root = Path(git.stdout.strip()).resolve() if git and git.returncode == 0 else Path.cwd()
    is_checkout = git is not None and git.returncode == 0
    if not is_checkout and not args.show_prompt:
        parser.error("run this in the target repository's Git checkout")
    tool = locate_tool(root, args.tool_root)
    has_charter = tool is not None and (tool / "README.md").is_file()
    if not has_charter and not args.show_prompt:
        parser.error(f"no {TOOL} charter found; set --tool-root DIR to its README.md directory. "
                     "--show-prompt still prints the workflow")

    if has_charter:
        context = f"Read `{tool / 'README.md'}` first; it is {TOOL}'s charter."
    else:
        context = (f"No checkout with {TOOL}'s README.md was found. Before working, locate "
                   "`anoieu/README.md` and read its charter; "
                   "--tool-root selects its directory. Do not invent the missing charter.")
    if not is_checkout:
        context += " This preview is outside a Git checkout; a real run requires one."
    task = TASK.format(tool=tool if has_charter else f"<{TOOL}-root>")
    prompt = f"""You are working in the target repository at `{root}`, following {TOOL}'s charter.
{context} Read this repository's own contributor instructions and relevant tests. Keep the
current branch and inspect existing changes before doing anything; preserve work
that was already here. Do not switch branches, pull, reset, or stash this tree.

{task}

Use Anoieu as the source of the worklist and its evidence. Make fixes only in this target
repository; leave dependency checkouts and Anoieu's finding database, ledger and
baselines unchanged. Put temporary analyzer output and builds
in temporary directories outside the source checkouts. Report the source revisions,
commands, actual results, fixes or review findings, and anything still unverified.
Do not commit, push, open a pull request, post a review or comment, or send anything
upstream. A person decides what to publish.
"""
    # Keep interpolated paths intact, including their spaces.
    prompt = prompt.strip() + "\n"
    if args.show_prompt:
        print(prompt, end="")
        return 0
    executable = shutil.which(args.agent)
    if executable is None:
        print(f"{COMMAND}: {args.agent} is not on PATH", file=sys.stderr)
        return 127
    argv = [args.agent]
    if args.noninteractive:
        argv.append("exec" if args.agent == "codex" else "-p")
    argv.append(prompt)
    print(f"-- {COMMAND}: {root}, via {args.agent}; charter: {tool / 'README.md'}", file=sys.stderr)
    os.chdir(root)
    os.execv(executable, argv)


if __name__ == "__main__":
    sys.exit(main())
