#!/usr/bin/env python3
"""eo_install -- put the Eunoia ecosystem on a machine, or say what is here.

    eo_install --status      # what is on this machine, and what is missing
    eo_install --dry-run     # the clone commands, run nothing
    eo_install               # clone what is not here yet
    eo_install --into DIR    # somewhere other than beside this checkout

Run it anywhere, in a repository of this ecosystem or outside one. **What to
clone comes from the register**, read live in the president's tree and
otherwise from the snapshot baked in when this file was installed -- so a run
away from that tree works, is offline, and says which it used. Re-install to
refresh the snapshot.

**Where the checkouts go** is beside the register's tree when you are standing
in it, and otherwise the working directory. `--into DIR` says where instead,
and every run names the directory it chose before it clones anything.

**The dry run prints exactly what a real run executes**, live rather than
commented out, so reading it is a review and pasting it does the same thing
this does. An inert dump would be a different text from the one that runs, and
the point of this one is that it is not.

## What it may run, and what it will not

The only command that installs anything is `git clone <url> <dir>`: no branch
flags, no checkout, no switch, so only a default branch is ever installed.
Making the directory is `os.makedirs` and the working directory is a `cwd=`
argument, so neither is a command. **Nothing is passed to a shell.**

**A directory that already exists is never touched** -- not cloned into, not
fetched into, not modified. It is reported and left, because a checkout is
somebody's working tree and the cost of being wrong about that is theirs.

**A child project is not a checkout.** It is a directory inside somebody else's
tree and it arrives when that tree does, so nothing here clones one. An
outsider is tracked and never cloned either: we do not install other people's
projects on their behalf.
"""

import argparse
import json
import os
import subprocess
import sys

#: Filled in when this file is installed, from the president's tree. Away from
#: that tree this command is **offline and may be out of date**, which is fine
#: and is the point: it works anywhere. What is not fine is a stale answer
#: presented as a current one, so every run that falls back to this says which
#: commit and date it came from.
EMBEDDED = None
EMBEDDED_FROM = ""

REGISTER = os.path.join("scripts", "ecosystem", "ecosystem.json")
CHECKOUTS = os.path.join("scripts", "ecosystem", "checkouts.json")

#: Every footing the policy defines. A value outside this set is a register
#: that has drifted from the page that defines it, which `--check` reports and
#: this module does not silently accept.
FOOTINGS = {"member", "associate", "candidate", "foundation", "president",
            "child", "outsider"}

WHERE = ("Run it at the root of the repository that holds the register -- the tree\n"
         "with scripts/ecosystem/ecosystem.json in it, which today is the\n"
         "president's -- and it reads the live register.\n\n"
         "Run it anywhere else and it is offline: it uses the snapshot baked in\n"
         "when this file was installed, names the commit and date that came\n"
         "from, and may be out of date. Re-install to refresh it. It never goes\n"
         "looking for a register elsewhere, and never presents a snapshot as\n"
         "the live one.")


def holds_register(root):
    """Is this the repository the register lives in?"""
    return bool(root) and os.path.isfile(os.path.join(root, REGISTER))


def require(root="."):
    """The register, and how current it is: `(data, provenance)`.

    **Live beats snapshot beats refusal**, in that order and never silently.
    Standing in the tree that holds the register, that file is read and the run
    is authoritative. Anywhere else, the snapshot taken at install time is used
    and the run says where it came from and when. With neither, this refuses
    rather than guessing -- there is no third place to look, by design.
    """
    root = os.path.abspath(os.path.expanduser(root))
    if holds_register(root):
        with open(os.path.join(root, REGISTER), encoding="utf-8") as handle:
            return json.load(handle), f"live, from {root}"
    if EMBEDDED is not None:
        return EMBEDDED, f"a snapshot taken at install time, {EMBEDDED_FROM}"
    raise SystemExit(
        f"-- refused: {root} does not hold {REGISTER}, and this copy carries no\n"
        f"   snapshot -- it was run out of a source tree rather than installed.\n\n"
        f"{WHERE}")


def checkouts(root="."):
    """The recorded checkout locations, where the tree has them. `{}` if not."""
    path = os.path.join(os.path.abspath(os.path.expanduser(root)), CHECKOUTS)
    if not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def entries(data):
    """The register's tools, as `(id, entry)`. Anything else is not a tool.

    The file carries prose alongside the entries -- a key whose value is a list
    of strings documenting the footings, for instance. A tool is a mapping with
    a `status`, and nothing here infers one that is missing.
    """
    return [(k, v) for k, v in data.items()
            if isinstance(v, dict) and "status" in v]


def problems(data):
    """What is wrong with the register, structurally. Offline, and no opinions.

    It never says a footing is the wrong one to have given somebody: that is a
    decision and not a defect. It says a footing is not one the policy defines,
    an entry is missing what every entry carries, or two entries claim the same
    repository -- each of which is a fact about the file.
    """
    bad = []
    seen = {}
    for name, entry in entries(data):
        footing = entry["status"]
        if footing not in FOOTINGS:
            bad.append(f"{name}: footing `{footing}` is not one the policy defines")
        if footing == "child":
            if not entry.get("parent"):
                bad.append(f"{name}: a child records no parent")
        elif not entry.get("url"):
            bad.append(f"{name}: no url, so nothing can be checked against it")
        repo = entry.get("url") or entry.get("repo")
        if repo:
            if repo in seen:
                bad.append(f"{name}: claims {repo}, which {seen[repo]} also claims")
            seen[repo] = name
    return bad


# --- the checkouts on this machine, and what the checker says about them ------
#
# Everything below reads the tree the register is in. That is not a limitation
# worked around: the caller already had to be standing there, so the mapping
# file and the exceptions file are local too, and nothing here goes looking
# outside the tree it was pointed at.

REPOS_FILE = os.path.join("scripts", "repos.local")


def locate(repo, root="."):
    """Where a tool is checked out on this machine, or "".

    The mapping file first, because it is a person's answer and beats a guess;
    then $ANOIEU_REPOS, then beside the register's tree, then $HOME. The id
    comes from the register, never from a path somebody typed.
    """
    root = os.path.abspath(os.path.expanduser(root))
    mapping = os.path.join(root, REPOS_FILE)
    if os.path.isfile(mapping):
        with open(mapping, encoding="utf-8") as handle:
            for line in handle:
                line = line.split("#", 1)[0].strip()
                parts = line.split(None, 1)
                if len(parts) == 2 and parts[0] == repo:
                    path = os.path.expanduser(parts[1].strip())
                    if os.path.isdir(path):
                        return path
    roots = [p for p in os.environ.get("ANOIEU_REPOS", "").split(os.pathsep) if p]
    for base in roots + [os.path.dirname(root), os.path.expanduser("~")]:
        candidate = os.path.join(base, repo)
        if os.path.isdir(candidate):
            return candidate
    return ""


def _git(*args, cwd=None):
    out = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else ""


def age(path):
    """How long since that checkout's last commit. `?` where it is not git."""
    when = _git("log", "-1", "--format=%cI", cwd=path)
    if not when:
        return "?"
    then = datetime.datetime.fromisoformat(when)
    days = (datetime.datetime.now(then.tzinfo) - then).days
    return "today" if days == 0 else f"{days}d"


#: Footings that are not repositories to clone. A child arrives inside its
#: parent; an outsider is tracked and is not ours to put on somebody's disk.
NOT_CLONED = {"child", "outsider"}


def plan(data, into):
    """What would be cloned, and what is already here: `(todo, here)`."""
    todo, here = [], []
    for name, entry in entries(data):
        if entry["status"] in NOT_CLONED or not entry.get("url"):
            continue
        repo = entry.get("repo") or name
        path = os.path.join(into, repo)
        (here if os.path.exists(path) else todo).append(
            (name, entry["status"], entry["url"], path))
    return todo, here


def clone(url, path):
    """The one command that installs anything. No shell, no branch flags."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    out = subprocess.run(["git", "clone", url, path],
                         capture_output=True, text=True)
    return out.returncode == 0, (out.stderr or out.stdout).strip()


def describe(path):
    """What a checkout that is already here looks like, without touching it."""
    out = subprocess.run(["git", "-C", path, "rev-parse", "--short", "HEAD"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        return "not a git checkout"
    dirty = subprocess.run(["git", "-C", path, "status", "--porcelain"],
                           capture_output=True, text=True)
    return out.stdout.strip() + (", with local changes" if dirty.stdout.strip()
                                 else "")


def main():
    parser = argparse.ArgumentParser(
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="eo_install -- put the Eunoia ecosystem on a machine, or "
                    "say what is here.\n\n"
                    "Run it anywhere, in a repository of this ecosystem or "
                    "outside one.\nCheckouts go beside the register's tree "
                    "when you are standing in it,\nand otherwise into the "
                    "working directory; --into DIR says where\ninstead, and "
                    "every run names the directory it chose.\n\n"
                    "What to clone comes from the register: live in the "
                    "president's tree,\notherwise the snapshot baked in when "
                    "this file was installed. A\ndirectory that already "
                    "exists is reported and never touched.",
        epilog="The only command that installs anything is `git clone`. "
               "Children arrive inside their parent and outsiders are never "
               "cloned.")
    parser.add_argument("--into", metavar="DIR",
                        help="where the checkouts go (default: beside this one)")
    parser.add_argument("--root", metavar="DIR", default=".",
                        help="a tree holding the register, to read it live")
    parser.add_argument("--status", action="store_true",
                        help="what is here and what is missing; clone nothing")
    parser.add_argument("--dry-run", action="store_true",
                        help="print the clone commands and run none of them")
    args = parser.parse_args()

    try:
        data, provenance = require(args.root)
    except SystemExit as exc:
        print(exc, file=sys.stderr)
        return 2
    if not provenance.startswith("live"):
        print(f"-- offline: {provenance}")

    # Beside the register's tree when we are standing in it -- that is where
    # the rest of the ecosystem belongs. Offline there is no such tree, and the
    # parent of wherever the run started is somebody else's directory, so the
    # working directory is used and named rather than guessed at.
    if args.into:
        into = os.path.abspath(os.path.expanduser(args.into))
    elif provenance.startswith("live"):
        into = os.path.dirname(os.path.abspath(args.root))
    else:
        into = os.getcwd()
    todo, here = plan(data, into)

    if args.status:
        print(f"-- {len(here)} here, {len(todo)} missing, under {into}")
        for name, footing, _, path in sorted(here):
            print(f"   {name:<14} {footing:<11} {describe(path)}")
        for name, footing, _, path in sorted(todo):
            print(f"   {name:<14} {footing:<11} not here")
        return 0

    if not todo:
        print(f"-- nothing to do: everything in the register is already under "
              f"{into}")
        return 0

    print(f"-- {len(todo)} to clone into {into}, {len(here)} already here")
    for name, footing, url, path in sorted(todo):
        print(f"   git clone {url} {path}")
    if args.dry_run:
        print("-- dry run: nothing was cloned. The lines above are what a real "
              "run executes")
        return 0

    failed = []
    for name, footing, url, path in sorted(todo):
        ok, why = clone(url, path)
        print(f"-- {name}: " + ("cloned" if ok else f"did not clone -- {why}"))
        if not ok:
            failed.append(name)
    print(f"-- {len(todo) - len(failed)} cloned, {len(failed)} failed"
          + (f": {', '.join(failed)}" if failed else ""))
    print("-- `eo_install --status` says where everything stands")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
