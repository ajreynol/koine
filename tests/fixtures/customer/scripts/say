#!/usr/bin/env bash
# The miniature script: it carries a copy of the prompts in docs/protocol.md and
# prints one under --show-prompt, which is the whole of what koine asks of it.
set -euo pipefail

WHICH=one
ID=""
POSTM=1
DRIFT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --show-prompt) shift ;;
    --two) WHICH=two; shift ;;
    --no-postm) POSTM=0; shift ;;
    --drift) DRIFT=1; shift ;;
    --fail) echo "say: something went wrong" >&2; exit 3 ;;
    *) ID="$1"; shift ;;
  esac
done

if [ -n "$ID" ]; then
  SCOPE="Find the row whose id is $ID, and address that row only."
  BRANCH="example-$ID"
else
  SCOPE="Address every open row."
  BRANCH="example-findings"
fi
[ "$DRIFT" = 0 ] || SCOPE="$SCOPE And do whatever else seems useful."

if [ "$WHICH" = one ]; then
  cat <<END
example is a tool. It has reported something against this project.

$SCOPE

Work on branch $BRANCH. Commit to it locally and push nothing.
END
  exit 0
fi

if [ "$POSTM" = 1 ]; then
  P="Write a postmortem entry for this run, whether or not anything changed."
else
  P="Decide whether this run earned a postmortem entry."
fi
cat <<END
A project has responded, at LINK.

Read it as two things: a triage, and a decision.

$P

Leave everything staged, and commit nothing.
END
