#!/usr/bin/env python3
"""koine_append_db -- add a run's new bugs to the database of every bug found.

    koine_append_db <new bugs> <bug database>

A tool in this ecosystem runs over somebody else's project and dumps what it
found: a JSON list of objects identified by `id`, or by `tool` and `bug`.
A `description` and any other fields are optional. That dump is about **one
run**. What nobody wants to keep by hand
is the other file -- every bug the tool has ever found, across every run, so that
a bug reported in March is still there in September and is still the same bug.

This script is the trip between the two. It reads the dump, reads the database,
and writes the database back with the new ones added.

## The one rule that makes it a database and not a pile

**A bug is added once.** Run the same dump twice and the second run adds nothing,
because a bug is identified by its `tool` and its `bug` together -- or by an `id`,
where the tool mints one. Re-running is therefore free and safe, which is the
property that lets this be wired into a job rather than remembered.

What a second sighting *does* change is `last_seen`. `first_seen` never moves.

## What it will not do

**Only last_seen changes for a bug already in the database; none is removed.**
If a later run describes a known bug differently, that is printed as a conflict
and the database keeps what it has. A record of what was found over time is
worth having only if nothing quietly rewrites it; deciding that a new
description is the better one is a person's call, not a script's.

**A bug in the database and not in the dump is left alone.** It may have been
fixed, or the run may simply not have looked there. This script cannot tell those
apart and does not guess.

**A bug the owner closed and this run found anyway is reported, and nothing is
done about it.** Closing a finding is the owner's decision and so is reopening
one; what this can say is that the two facts in the file now disagree -- somebody
ruled the claim false, and a later run saw it again. That contradiction is the
only thing that surfaces a wrong closure, because a closed entry is one nothing
re-derives, and until now it was recorded and never mentioned: the run printed
*1 already known* and moved on. It is printed as a **reopen candidate**, in the
same place a conflict is, and the closure fields are left exactly as they are.

An entry is closed when it carries any field named `closed_*`. That is the
convention its owners already keep -- `closed_on`, `closed_commit`, `closed_why`,
`closed_verdict` -- and reading the prefix rather than one name is what keeps this
out of deciding whose vocabulary is the right one.

**Nothing is written unless every entry in the dump is readable.** A dump with
one malformed entry writes nothing at all, so a half-applied run is not a state
the database can be in.

## Two runs at once

**A run holds an exclusive lock on the database while it reads, merges and
writes it.** *Added once* is a claim about a file two tools append to, and
without a lock it is only true of runs that happen not to overlap: both read the
same database, both merge their own dump into it, and the second replace throws
the first run's bugs away. Nothing reports that, because from inside either run
everything worked.

The lock is `<database>.lock`, taken with `flock` and released when the process
ends however it ends. A run that cannot take it within `--lock-timeout` seconds
**refuses and writes nothing**, which is the safe direction: the dump is still
there and re-running is free.

**`--no-lock` is the way past**, and it is for a caller that already holds one
-- a tool serialising its own database access around this call would otherwise
take the same lock twice -- and for a platform with no `flock`, where a run
refuses rather than pretending to be serialised. A caller passing it is saying
*I have arranged this*, and owns the guarantee from there.

A **reading** run -- `--dry-run` -- takes no lock and needs none: the database is
replaced atomically, so a reader sees one whole version or another and never a
half-written one.

## The files

The dump, and the database, are the same shape -- so a database can be fed back
in as a dump, and a dump can be read by anything that reads the database:

    {"bugs": [{"bug": "EO0031-ArithExt-17",
               "tool": "anoieu",
               "description": "`@arith_vts_delta` is declared twice"}]}

A bare JSON list is accepted too, since that is what a tool's first dump usually
is. What is written is always the object form, with the bugs in the order they
were first seen.

**A database keeps saying what it holds.** The key is read from the file rather
than assumed, and written back unchanged, so a consumer whose records are not
defects -- a rewrite database holding `{"rewrites": [...]}` -- is read and
written by this like any other. `--records` names the key for a database this
run creates; an existing one keeps its own. koine's tooling is called bug_db
either way: the mechanics of *added once*, of a lock, and of an atomic replace
do not depend on what the records are.
"""

import argparse
import contextlib
import datetime
import errno
import json
import os
import sys
import time

try:
    import fcntl
except ImportError:                                  # not a POSIX platform
    fcntl = None

#: A run that could not take the lock. Distinct from an unreadable dump,
#: because *somebody else is writing* and *you gave me rubbish* call for
#: different things from whatever wrapped this call.
BUSY = 3

#: The fields this script knows about, in the order it writes them. A tool may
#: carry any others it likes -- a path, a line, a severity, a URL -- and they are
#: kept exactly as they arrive. Nothing here decides what a bug is.
FIELDS = ("id", "bug", "tool", "description", "first_seen", "last_seen")

#: How an entry says its owner has ruled on it. A prefix rather than a name,
#: because the vocabulary past it is the owner's: anoieu writes a
#: `closed_verdict` from a list of seven words, dokimasia writes a `closed_on`
#: and a `closed_pr`, and neither is koine's to know. What is shared is that a
#: ruled-on entry is marked, and that a later sighting contradicts the ruling.
CLOSED = "closed_"

#: What a database calls the list it holds, when it is new and nobody said.
#: An existing one keeps whatever key it already uses -- koine's two consumers
#: keep `bugs`, and a third whose records are not defects can hold `rewrites`
#: and go on being read and written by this. The word is the owner's; the
#: mechanics are the same either way.
RECORDS = "bugs"

#: What identifies a bug, when the tool does not mint an id of its own. Two
#: tools may well use the same local name for different bugs, so the tool is
#: half of the key.
KEY = ("tool", "bug")


def key_of(entry):
    """What this bug is, for the purpose of *have we seen it before*."""
    if entry.get("id"):
        return ("id", str(entry["id"]))
    # Keep the two identity forms disjoint: tool="id", bug="x" is not id="x".
    return ("tool+bug", *(str(entry.get(name, "")) for name in KEY))


def closure(entry):
    """What the owner recorded when they closed this, or nothing.

    Read and never written. A run that sees a closed bug again reports it; what
    to do about it -- reopen it, correct it, leave it -- is the owner's, and this
    script has no opinion it could act on.
    """
    return {name: entry[name] for name in entry if name.startswith(CLOSED)}


def problems(entries, where):
    """Why this dump cannot be applied, or nothing."""
    out = []
    for n, entry in enumerate(entries, start=1):
        at = f"{where}, bug {n}"
        if not isinstance(entry, dict):
            out.append(f"{at}: not an object")
            continue
        if not entry.get("id"):
            for name in KEY:
                if not str(entry.get(name, "")).strip():
                    out.append(f"{at}: no `{name}`, and no `id` either -- "
                               "there is then nothing to identify it by")
    seen = {}
    for n, entry in enumerate(entries, start=1):
        if not isinstance(entry, dict):
            continue
        k = key_of(entry)
        if k in seen:
            out.append(f"{where}, bug {n}: the same bug as bug {seen[k]} "
                       f"({' '.join(k)})")
        else:
            seen[k] = n
    return out


def read_bugs(path, missing_ok=False):
    """The records in a file, and what that file calls them.

    Returns the records and the envelope key they arrived under, so that a
    database keeps saying what it holds. A bare list has no key and gets the
    default.
    """
    if missing_ok and not os.path.exists(path):
        return [], ""
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    if isinstance(data, list):
        return data, ""
    if isinstance(data, dict):
        keys = [k for k, v in data.items() if isinstance(v, list)]
        if len(keys) == 1:
            return data[keys[0]], keys[0]
        if len(keys) > 1:
            raise ValueError(f"{path}: {len(keys)} lists in it ({', '.join(keys)}) "
                             "and no way to tell which one is the records")
    raise ValueError(f"{path}: expected a list of records, or an object with one "
                     "list in it")


def ordered(entry):
    """One bug, with the known fields first and everything else after.

    The order is fixed so that the database's diff shows what changed rather
    than how the last writer happened to feel about key order.
    """
    out = {name: entry[name] for name in FIELDS if name in entry}
    for name in sorted(entry):
        if name not in out:
            out[name] = entry[name]
    return out


def append(db, new, date):
    """Fold a run's bugs into the database. Returns what happened.

    `db` is modified in place and returned, so a caller that wants the old one
    keeps its own copy.
    """
    index = {key_of(entry): entry for entry in db}
    added, again, conflicts, reopen = [], [], [], []

    for entry in new:
        k = key_of(entry)
        known = index.get(k)
        if known is None:
            fresh = dict(entry)
            fresh.setdefault("first_seen", date)
            fresh["last_seen"] = date
            db.append(ordered(fresh))
            index[k] = db[-1]
            added.append(k)
            continue

        # Seen again, and the owner had ruled it closed. Noted before anything
        # else is touched, and nothing about the closure is touched at all: the
        # entry keeps its verdict and this run keeps its report.
        ruled = closure(known)
        if ruled:
            reopen.append((k, ruled.get("closed_on", "")))

        for name, value in entry.items():
            if name in ("first_seen", "last_seen"):
                continue
            if name in known and known[name] != value:
                conflicts.append((k, name, known[name], value))
        known["last_seen"] = date
        index[k] = known
        again.append(k)

    return db, added, again, conflicts, reopen


def write_db(path, bugs, records=RECORDS):
    """Write the database, and do not leave a half-written one behind.

    The temporary file is named for the process that wrote it. A fixed name was
    a second way two runs could ruin each other even with the lock held: a run
    killed between the write and the rename leaves the name taken, and the next
    run happily writes over somebody's file. It sits beside the database so the
    rename stays on one filesystem and so stays atomic.
    """
    body = json.dumps({records: [ordered(b) for b in bugs]},
                      indent=2, ensure_ascii=False) + "\n"
    tmp = f"{path}.writing.{os.getpid()}"
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(body)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.remove(tmp)
        raise


@contextlib.contextmanager
def held(path, seconds):
    """An exclusive lock on the database, for as long as this run needs it.

    `flock` on `<database>.lock`, which the kernel drops when the process ends
    however it ends -- so a killed run leaves a stale file and never a stale
    lock. Polled rather than blocking, so that *waited and gave up* is a state
    this script can report instead of a run somebody has to notice is hung.
    """
    if fcntl is None:
        raise RuntimeError(
            "this platform has no flock, so two runs at once cannot be kept "
            "apart. Serialise the calls yourself and pass --no-lock")
    lock = path + ".lock"
    handle = open(lock, "a+")
    deadline = time.monotonic() + max(0.0, seconds)
    while True:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError as exc:
            if exc.errno not in (errno.EACCES, errno.EAGAIN):
                handle.close()
                raise
            if time.monotonic() >= deadline:
                handle.close()
                raise TimeoutError(
                    f"{lock} is held by another run, and {seconds:g}s was as "
                    f"long as this one was told to wait")
            time.sleep(0.05)
    try:
        yield
    finally:
        handle.close()


def by_tool(bugs):
    """How many each tool contributed -- or nothing, where none names one.

    A record identified by an `id` alone carries no tool and owes none. A
    breakdown reading `? 197` is not a breakdown, so a database where nobody
    named a tool gets none rather than one about a question mark.
    """
    counts = {}
    for entry in bugs:
        name = str(entry.get("tool", "")).strip()
        if name:
            counts[name] = counts.get(name, 0) + 1
    return counts


def noun(records):
    """What to call one of them, from what the database calls all of them.

    `bugs` gives `bug(s)` and `rewrites` gives `rewrite(s)`, so a run over a
    rewrite database does not report in bugs. Crude on purpose: the owner chose
    a plural noun and this takes the `s` off it, rather than koine acquiring
    opinions about English.
    """
    return (records[:-1] if records.endswith("s") else records) + "(s)"


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="koine_append_db",
        description="Add a run's new bugs to the database of every bug found.")
    ap.add_argument("new", metavar="<new bugs>",
                    help="a run's dump: a JSON list of bugs")
    ap.add_argument("db", metavar="<bug database>",
                    help="the database; created if it is not there yet")
    ap.add_argument("--dry-run", action="store_true",
                    help="say what would change and write nothing")
    ap.add_argument("--date", default=datetime.date.today().isoformat(),
                    help="the date to record this run under (default: today)")
    ap.add_argument("--lock-timeout", type=float, default=30.0, metavar="S",
                    help="how long to wait for another run to finish with the "
                         "database before refusing (default: 30)")
    ap.add_argument("--records", default=RECORDS, metavar="KEY",
                    help="what a database this run creates calls its list "
                         f"(default: {RECORDS}); an existing database keeps the "
                         "key it already uses and this is ignored")
    ap.add_argument("--no-lock", action="store_true",
                    help="do not lock the database: for a caller that already "
                         "serialises its own access, and the way past on a "
                         "platform with no flock")
    args = ap.parse_args(argv)

    # Held across the read, the merge and the write, because *a bug is added
    # once* is a claim about the three of them together. A dry run reads and
    # writes nothing, so it needs none.
    with contextlib.ExitStack() as stack:
        if not (args.dry_run or args.no_lock):
            try:
                stack.enter_context(held(args.db, args.lock_timeout))
            except (OSError, RuntimeError, TimeoutError) as exc:
                print(f"-- refused: {exc}", file=sys.stderr)
                return BUSY
        return run(args)


def run(args):
    """The work, with the database already locked if it is going to be."""
    try:
        new, _ = read_bugs(args.new)
        db, records = read_bugs(args.db, missing_ok=True)
        # What this database calls its list, and so what a run reports in. An
        # existing one keeps its own word; a new one takes --records.
        records = records or args.records
    except (OSError, ValueError) as exc:
        print(f"-- refused: {exc}", file=sys.stderr)
        return 1

    bad = problems(new, args.new) + problems(db, args.db)
    if bad:
        print(f"-- refused: {len(bad)} unreadable entry(s), and nothing was "
              "written", file=sys.stderr)
        for line in bad:
            print(f"   {line}", file=sys.stderr)
        return 1

    fresh = os.path.exists(args.db)
    before = len(db)
    db, added, again, conflicts, reopen = append(db, new, args.date)

    for k, name, was, now in conflicts:
        print(f"-- conflict: {' '.join(k)} `{name}` is kept as {was!r}, "
              f"and this run said {now!r}", file=sys.stderr)

    # Beside the conflicts, because both are the same kind of thing: the file
    # and the run disagree, the file wins, and somebody is told.
    for k, when in reopen:
        print(f"-- reopen candidate: {' '.join(k)} was closed"
              + (f" on {when}" if when else "")
              + f", and this run saw it again on {args.date}", file=sys.stderr)

    # Always counted, including when it is zero. A run that looked and found no
    # contradiction and a run with no closed entry to contradict are different
    # results, and a counter that appears only when it fires reports neither.
    one = noun(records)
    print(f"-- {len(added)} new {one}, {len(again)} already known, "
          f"{len(conflicts)} conflict(s), {len(reopen)} reopen candidate(s)")
    counts = by_tool(db)
    print(f"-- the database holds {len(db)} {one}"
          + (f" from {len(counts)} tool(s): "
             + ", ".join(f"{t} {n}" for t, n in sorted(counts.items()))
             if counts else ""))

    if args.dry_run:
        print(f"-- dry run: {args.db} is unchanged, and would have gone from "
              f"{before} to {len(db)}")
        return 0

    try:
        write_db(args.db, db, records)
    except OSError as exc:
        print(f"-- refused: {exc}", file=sys.stderr)
        return 1
    print(f"-- wrote {args.db}" + ("" if fresh else " (created)"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
