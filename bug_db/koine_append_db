#!/usr/bin/env python3
"""Compatibility entry point; the implementation lives in bug_db_manager.

Keep existing consumer locators working while they update their paths and pins.
This launcher has no database logic; installed copies use the implementation.
"""

from pathlib import Path
import runpy


if __name__ == "__main__":
    runpy.run_path(
        str(Path(__file__).resolve().parents[1]
            / "bug_db_manager" / "koine_append_db"),
        run_name="__main__",
    )
