#!/usr/bin/env python3
"""koine_history -- read changes to a history record and report review signals.

    koine_history /path/to/record-repository
    koine_history /path/to/record-repository --since <sha> --append
    koine_history /path/to/record-repository --file docs/history.md

The record is one file -- `docs/history.md` by default -- and it travels with
the office that keeps it, so the tree it lives in is an argument and never a
constant here. Point this at whichever repository holds it today.

**This program has no opinion.** It reports signals: what a change touched, what
it added and removed, and which of the questions in `docs/history-review.md` a
reader should ask about it. **The verdict is not its to write.** A person, or an
agent a person set to work, writes the verdict into `docs/history-ledger.md` in
this koine checkout. `--append` adds rows for changes that have none and never
touches a row that does. Without it, nothing is written.

Where the signals and `docs/history-review.md` disagree, the document is right
and this is the copy. Nothing compares them automatically.

The one limit worth knowing before trusting a run: a change made under a
different filename is followed for enumeration and not for content, so a
rename shows as a change this program cannot read. It says so rather than
reporting an empty diff as a quiet change.
"""

import os
import re
import subprocess
import sys

RECORD = "docs/history.md"
LEDGER = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                      "docs", "history-ledger.md")

EVIDENCE = re.compile(r"\]\(|\b[0-9a-f]{7,40}\b|\b20\d\d-\d\d-\d\d\b|#\d+")
FIGURE = re.compile(r"\b\d{2,}\b|\d%|\b\d+%")
MEMBERSHIP = re.compile(
    r"\bjoined\b|\bmembership\b|\bfooting\b|\bmember\b|\bassociate\b"
    r"|\bcandidate\b|\bfoundation\b|outside-candidate", re.I)
FAILURE = re.compile(
    r"went wrong|\bfailed\b|\bfailure\b|\bred\b|\bbroke\b|\bbroken\b"
    r"|could not|\bunverified\b|\bwrong\b|\bmissed\b|\boverdue\b|\bnobody\b", re.I)
STRETCH = re.compile(r"^##\s+Stretch\s+(\d+)")


class Change:
    """One commit that touched the record."""

    def __init__(self, sha, date, subject, added, removed, sections, signals):
        self.sha, self.date, self.subject = sha, date, subject
        self.added, self.removed = added, removed
        self.sections, self.signals = sections, signals

    @property
    def net(self):
        return len(self.added) - len(self.removed)

    def __repr__(self):
        return f"<Change {self.sha[:8]} +{len(self.added)}-{len(self.removed)}>"


def _git(repo, *args):
    got = subprocess.run(("git", "-C", repo) + args,
                         capture_output=True, text=True)
    if got.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {got.stderr.strip()[:200]}")
    return got.stdout


def _headings(text):
    """Line number -> the `##` heading it falls under, 1-based."""
    out, current = {}, "(before the first heading)"
    for n, line in enumerate(text.split("\n"), start=1):
        if line.startswith("## "):
            current = line[3:].strip()
        out[n] = current
    return out


def _latest_stretch(text):
    """The number of the stretch currently being written, or None.

    Not simply the highest heading present. A record carries a heading for the
    stretch that has not begun -- the successor's, held open -- and counting it
    would make the open entry look like an earlier one, which is the difference
    between ordinary writing and a correction of somebody else's stretch.
    """
    seen = []
    for line in text.split("\n"):
        m = STRETCH.match(line)
        if m and "not started" not in line.lower():
            seen.append(int(m.group(1)))
    return max(seen) if seen else None


def _hunks(diff):
    """(new_start, added_lines, removed_lines) for each hunk of a -U0 diff."""
    out, head = [], re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")
    start, added, removed = None, [], []
    for line in diff.split("\n"):
        m = head.match(line)
        if m:
            if start is not None:
                out.append((start, added, removed))
            start, added, removed = int(m.group(1)), [], []
        elif start is None:
            continue
        elif line.startswith("+") and not line.startswith("+++"):
            added.append(line[1:])
        elif line.startswith("-") and not line.startswith("---"):
            removed.append(line[1:])
    if start is not None:
        out.append((start, added, removed))
    return out


def _signals(hunks, headings, latest, unreadable):
    """Mechanical questions from `docs/history-review.md`. Flags, never verdicts."""
    added = [l for _, a, _ in hunks for l in a]
    removed = [l for _, _, r in hunks for l in r]
    flags = {}

    if unreadable:
        flags["unreadable"] = "renamed or absent under this path at this commit"
        return flags

    touched_earlier, shown = [], True
    for start, a, _r in hunks:
        section = headings.get(start) or headings.get(max(headings or {1: ""}))
        m = STRETCH.match("## " + (section or ""))
        if m and latest is not None and int(m.group(1)) != latest:
            touched_earlier.append(section)
            if not any(EVIDENCE.search(l) for l in a):
                shown = False
    if touched_earlier:
        flags["earlier stretch"] = ", ".join(sorted(set(touched_earlier)))
        if not shown:
            flags["no demonstration"] = "an earlier entry changed with no evidence added"

    gone = [l for l in removed if MEMBERSHIP.search(l)]
    if gone and len(gone) > len([l for l in added if MEMBERSHIP.search(l)]):
        flags["membership removed"] = f"{len(gone)} line(s) naming a footing"

    figures = [l for l in added if FIGURE.search(l)]
    if figures:
        flags["figures added"] = str(len(figures))
        bare = [l for l in figures if not EVIDENCE.search(l)]
        if bare:
            flags["figures unsupported"] = f"{len(bare)} carry no link, commit or date"

    if any("FIXME" in l for l in added):
        flags["placeholder"] = "FIXME"

    lost = len([l for l in removed if FAILURE.search(l)])
    kept = len([l for l in added if FAILURE.search(l)])
    if lost > kept:
        flags["failure language removed"] = f"{lost} out, {kept} in"

    prose = [l for l in added if l.strip() and not EVIDENCE.search(l)
             and not FIGURE.search(l)]
    if added and len(prose) == len([l for l in added if l.strip()]) and len(prose) > 5:
        flags["nothing checkable added"] = f"{len(prose)} line(s) of prose"

    return flags


def changes(repo, path=RECORD, since=None):
    """Every commit that touched the record, oldest first."""
    span = f"{since}..HEAD" if since else "HEAD"
    log = _git(repo, "log", "--follow", "--reverse", "--date=short",
               "--format=%H%x00%ad%x00%s", span, "--", path)
    out = []
    for line in log.strip().split("\n"):
        if not line:
            continue
        sha, date, subject = line.split("\0")
        diff = _git(repo, "show", "--no-color", "--unified=0", "--find-renames",
                    "--format=", sha, "--", path)
        hunks = _hunks(diff)
        try:
            after = _git(repo, "show", f"{sha}:{path}")
            headings, latest = _headings(after), _latest_stretch(after)
        except RuntimeError:
            headings, latest = {}, None
        flags = _signals(hunks, headings, latest, unreadable=not hunks)
        sections = sorted({headings.get(s, "?") for s, _, _ in hunks})
        out.append(Change(sha, date, subject,
                          [l for _, a, _ in hunks for l in a],
                          [l for _, _, r in hunks for l in r],
                          sections, flags))
    return out


def report(items, stream=sys.stdout):
    """Print what is true of each change. Returns the number read."""
    for c in items:
        print(f"{c.sha[:8]}  {c.date}  +{len(c.added)} -{len(c.removed)}"
              f"  {c.subject[:56]}", file=stream)
        for section in c.sections:
            print(f"          in: {section}", file=stream)
        for name, why in c.signals.items():
            print(f"          ?? {name}: {why}", file=stream)
        if not c.signals:
            print("          -- no signal; the reading is the whole of it",
                  file=stream)
    print(f"-- {len(items)} change(s) read", file=stream)
    return len(items)


def recorded(ledger=LEDGER):
    """The shas the ledger already carries, however they were abbreviated.

    Matched as prefixes, because a row may have been written by hand at a
    different length than a run would write it.
    """
    if not os.path.exists(ledger):
        return set()
    return set(re.findall(r"^\|\s*`([0-9a-f]{7,40})`", open(ledger).read(), re.M))


def append(items, repo_id, ledger=LEDGER):
    """Add a row per unrecorded change. Never rewrites one.

    Additive on purpose: a verdict is written by hand into a row, and a
    generator that may rewrite is a generator that may quietly delete one.
    """
    have = recorded(ledger)
    fresh = [c for c in items
             if not any(c.sha.startswith(seen) for seen in have)]
    if not fresh:
        return 0
    with open(ledger, "a") as fh:
        for c in fresh:
            signals = "; ".join(f"{k}" for k in c.signals) or "none"
            fh.write(f"| `{c.sha[:8]}` | {c.date} | {repo_id} | "
                     f"+{len(c.added)}/-{len(c.removed)} | {signals} | | |\n")
    return len(fresh)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    repo, path, since, doappend = argv[0], RECORD, None, False
    rest = argv[1:]
    while rest:
        flag = rest.pop(0)
        if flag == "--file":
            path = rest.pop(0)
        elif flag == "--since":
            since = rest.pop(0)
        elif flag == "--append":
            doappend = True
        else:
            print(f"!! unknown argument: {flag}", file=sys.stderr)
            return 2
    if not os.path.isdir(os.path.join(repo, ".git")):
        print(f"!! not a git checkout: {repo}", file=sys.stderr)
        return 2
    items = changes(repo, path, since)
    report(items)
    if doappend:
        added = append(items, os.path.basename(os.path.abspath(repo)))
        print(f"-- {added} row(s) added to the ledger; "
              f"{len(items) - added} already recorded")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
