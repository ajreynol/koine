#!/usr/bin/env python3
"""install_eo -- set up the Eunoia ecosystem on this machine.

    scripts/install_eo --prefix ~/bin  # install the commands, and remember where
    scripts/install_eo                 # later runs need no arguments
    scripts/install_eo --status        # what is installed, and whether it is current
    scripts/install_eo --init-clone    # clone the ecosystem's repositories
    scripts/install_eo --uninstall     # remove what this script installed
    scripts/install_eo --verbose       # and show every file, one row each

**Two jobs, and between them they are what a machine needs before any of this
is usable.**

**The commands, onto a PATH.** Everything in `eo_cmd/` is written to run *inside
somebody else's repository* -- the one being started, joined, tidied or answered
-- rather than inside this one. A command shaped like that is no use sitting in
a checkout whose path somebody has to remember, so this copies each onto a
directory on their PATH and remembers which directory, so that later runs need
no arguments.

**The repositories, onto the disk.** `--init-clone` reads the register the
president holds and clones what is missing beside it. Several of the installed
commands go looking for sibling checkouts -- for the policy and the vision, for
the register, for another tool's discussion file -- and do strictly less without
them, so a fresh machine wants this before it wants anything else.

`eo_cmd/commands.json` lists what is installable. koine maintains all of them,
under `R35` for the two that run inside a repository being started or joined and
`R16` for the rest; what joining *costs* is `R4`'s and stays with the office.

**They were copies until 2026-09-17**, kept byte-identical to kanon's
`prompts/join_eo` and `prompts/init_eo`, and this script policed that with a
`--sync` and a `--check` that re-derived each copy from its original. kanon then
deleted its pair and the role moved here, so there is no original to check
against and nothing left to police. Both options were removed rather than left
pointing at a repository that no longer holds the files.

## The configuration

`install_eo_cmd.local.json` at the root of this checkout, which the repository
ignores by the ecosystem's `*.local.json` convention. It records the directory
chosen and what was installed into it, so a later run can tell a file it
installed from a file somebody else's tooling put there under the same name.

**It never overwrites a file it did not install.** A name already taken in the
target directory is reported and skipped; `--force` is how a person overrides
that, and it is a person's call because the file being replaced is theirs.
"""

import argparse
import hashlib
import json
import os
import re
import datetime
import shlex
import shutil
import stat
import subprocess
import sys
import textwrap

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
STORE = os.path.join(ROOT, "eo_cmd")
MANIFEST = os.path.join(STORE, "commands.json")
# Keep installation state stable across command renames: it records both the
# chosen directory and which installed files this script owns.
CONFIG = os.path.join(ROOT, "install_eo_cmd.local.json")

#: Where the commands go when nobody has said otherwise. A person's own bin
#: directory rather than anything shared: this installs somebody's tools for
#: them, and has no business writing where another account would see it.
DEFAULT_PREFIX = "~/bin"


def digest(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def rel(path):
    """A path as a person would type it, from the checkout they ran this in."""
    inside = os.path.relpath(path, ROOT)
    return path if inside.startswith(os.pardir) else inside


#: How wide a message is allowed to get. A terminal is 80 and a line that runs
#: to the edge is read twice.
WIDTH = 78


def say(text, stream=None, lead="-- "):
    """One message, wrapped, with continuation lines hung under the first.

    **Every message here used to be wrapped by hand** in the middle of a string
    literal, so each broke at whatever column the *source* happened to reach and
    the second half started at the left margin looking like a new statement. A
    person reading a dozen of those cannot see where one message ends and the
    next begins, which is most of why a run of this script was hard to read.
    So messages are written as one sentence and wrapped here, and everything
    after the first line is indented to sit under it.

    Long paths are never broken: half a path on each of two lines is not a path
    anybody can copy, and copying it is the whole reason it was printed.
    """
    body = textwrap.fill(" ".join(text.split()), width=WIDTH,
                         initial_indent=lead, subsequent_indent=" " * len(lead),
                         break_long_words=False, break_on_hyphens=False)
    # Both streams, every time: a report that mixes them comes out shuffled the
    # moment somebody pipes it, which is when a warning is most likely to end
    # up above the line it is a warning about.
    sys.stdout.flush()
    sys.stderr.flush()
    out = stream or sys.stdout
    print(body, file=out)
    out.flush()


def table(rows, head=None, indent="   "):
    """Columns that line up, so a reader can go down one instead of across all.

    The last column is never padded, so a long note at the end of a row costs
    nothing to the rows above it.
    """
    rows = [tuple(str(cell) for cell in row) for row in rows]
    if not rows:
        return
    body = ([tuple(str(h) for h in head)] if head else []) + rows
    widths = [max(len(r[i]) for r in body) for i in range(len(body[0]) - 1)]
    for row in body:
        line = indent + "  ".join(
            cell.ljust(widths[i]) if i < len(widths) else cell
            for i, cell in enumerate(row))
        print(line.rstrip())


def these(names):
    """`a`, `a and b`, `a, b and c` -- a list of names inside a sentence.

    Printed one per line, a message that applies to nine files is the same
    sentence nine times and a reader skips all nine. Said once, with the names
    in it, it is a sentence they read.
    """
    names = list(names)
    if len(names) < 3:
        return " and ".join(names)
    return ", ".join(names[:-1]) + " and " + names[-1]


def homely(path):
    """A path as somebody would write it, with their home directory as `~`.

    The absolute path to a directory under somebody's home is the longest thing
    this script prints and the least informative part of what it prints:
    An expanded home path and `~/bin` name the same directory and only one of them
    wraps onto a second line.
    """
    home = os.path.expanduser("~")
    if home and (path == home or path.startswith(home + os.sep)):
        return "~" + path[len(home):]
    return path


def shell_path(path):
    """The same path for a line somebody pastes into a shell.

    `~` is not it: inside the double quotes that `export PATH="..."` wants, a
    tilde is a literal tilde and the line silently does nothing. `$HOME` is
    what expands there.
    """
    home = os.path.expanduser("~")
    if home and (path == home or path.startswith(home + os.sep)):
        return "$HOME" + path[len(home):]
    return path


def plan_lines(rows):
    """Left-aligned `<op> <path>` lines, so a column can be read down.

    What `--uninstall` prints, where the path is the point: a preview of files
    about to be deleted names each one in full, and `~` is the one shortening
    that costs nothing -- it is the reader's own home, and the line still
    pastes into a shell and means what it says.
    """
    if not rows:
        return
    width = max(len(row[0]) for row in rows)
    for left, right, why in rows:
        line = f"   {left:<{width}}  {right}" + (f"   ({why})" if why else "")
        print(line.rstrip())


def read_text(path):
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def read_json(path, missing_ok=False):
    if missing_ok and not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def write_json(path, data):
    """Replace a file in one step, so an interrupted run leaves the old one."""
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, sort_keys=False)
        handle.write("\n")
    os.replace(tmp, path)


#: The register, relative to the root of the repository that holds it. Whoever
#: holds it is the president; nothing here decides that, it is read from the
#: file itself.
REGISTER = os.path.join("scripts", "ecosystem", "ecosystem.json")

#: The line a command carries when it wants the register baked in, and what it
#: is replaced with. A command that does not carry it gets nothing.
SENTINEL = "EMBEDDED = None"


def find_president(given=None):
    """The tree holding the register, and what we can say about its state.

    **Nothing here decides who the president is.** The register records that,
    and the tree that holds the register is the one to read it from.

    **A tree somebody named is used or refused, never replaced.** `--president`
    and `KANON` are somebody saying *read the register there*; if that tree does
    not hold one, falling through to a different tree would answer a question
    nobody asked, with a register whose age and provenance the run has no reason
    to trust. Only the unnamed case looks at a sibling of this checkout, which
    is a guess and is the one place a guess is the whole point.
    """
    named = given or os.environ.get("KANON", "")
    if named:
        named = os.path.abspath(os.path.expanduser(named))
        return named if os.path.isfile(os.path.join(named, REGISTER)) else ""
    sibling = os.path.join(os.path.dirname(ROOT), "kanon")
    return sibling if os.path.isfile(os.path.join(sibling, REGISTER)) else ""


def named_president(given=None):
    """The tree somebody named, if they named one. `""` if nobody did.

    Only for a message: a run that refuses should say *the tree you named holds
    no register* rather than *none was found*, which reads as though nobody had
    said where to look.
    """
    named = given or os.environ.get("KANON", "")
    return os.path.abspath(os.path.expanduser(named)) if named else ""


#: What an installed command actually reads out of an entry. Everything else in
#: the register is the office's business -- when a footing was vetted, why, the
#: commit somebody joined at -- and baking it in would put a copy of somebody's
#: reasoning on a stranger's disk with no way to keep it current.
KEEP = ("status", "url", "repo", "parent")

#: Footings first, in the order a reader takes the ecosystem in.
ORDER = ("president", "member", "associate", "candidate", "foundation",
         "outsider", "child")


def as_source(data, where):
    """The register as Python somebody can read, not a line of JSON.

    An installed command is a file people open. A single 23KB line of `{...}`
    in the middle of one is not a snapshot anybody can check against the
    register, which defeats the point of naming where it came from -- so this
    writes it out grouped by footing, one entry per line, sorted, with only the
    fields a command reads.
    """
    rows = {k: v for k, v in data.items()
            if isinstance(v, dict) and "status" in v}
    out = ["EMBEDDED = {",
           f"    # The register, {where}.",
           "    # Grouped by footing; only the fields these commands read.",
           "    # Re-install to refresh it. The live register is the office's.",
           ""]
    for footing in ORDER:
        group = sorted(k for k, v in rows.items() if v["status"] == footing)
        if not group:
            continue
        out.append(f"    # -- {footing} --")
        for name in group:
            entry = rows[name]
            fields = {k: entry[k] for k in KEEP if entry.get(k)}
            what = entry.get("short") or entry.get("what") or ""
            if what:
                fields["short"] = what
            body = ", ".join(f"{k!r}: {v!r}" for k, v in fields.items())
            out.append(f"    {name!r}: {{{body}}},")
        out.append("")
    unknown = sorted(k for k, v in rows.items() if v["status"] not in ORDER)
    if unknown:
        out.append("    # -- footings this version of the command did not know --")
        for name in unknown:
            out.append(f"    {name!r}: {rows[name]!r},")
    out.append("}")
    return "\n".join(out)


def snapshot(president):
    """The register as JSON, and a sentence saying where and when it came from.

    The provenance is not decoration. What gets baked into an installed command
    is a **snapshot**, and every run that falls back to it has to be able to say
    which commit it was taken at and whether that checkout was clean -- a
    snapshot from somebody's half-edited working tree is a different fact from
    one taken at a commit, and the reader is entitled to know which.
    """
    with open(os.path.join(president, REGISTER), encoding="utf-8") as handle:
        data = json.load(handle)
    commit = subprocess.run(["git", "-C", president, "rev-parse", "--short", "HEAD"],
                            capture_output=True, text=True)
    commit = commit.stdout.strip() if commit.returncode == 0 else ""
    dirty = subprocess.run(["git", "-C", president, "status", "--porcelain",
                            "--", REGISTER], capture_output=True, text=True)
    edited = bool(dirty.stdout.strip())
    where = f"from {os.path.basename(president)}"
    if commit:
        where += f" at {commit}"
        if edited:
            where += " with the register edited and not committed"
    where += f", on {datetime.date.today().isoformat()}"
    return data, where


def install_file(src, dest, embed=None):
    """Copy, executable, atomically -- baking in the register where asked."""
    tmp = dest + ".tmp"
    if embed is None:
        shutil.copyfile(src, tmp)
    else:
        data, where = embed
        text = read_text(src)
        if SENTINEL not in text:
            shutil.copyfile(src, tmp)
        else:
            text = text.replace(SENTINEL, as_source(data, where), 1)
            text = text.replace('EMBEDDED_FROM = ""',
                                f"EMBEDDED_FROM = {where!r}", 1)
            with open(tmp, "w", encoding="utf-8") as handle:
                handle.write(text)
    os.chmod(tmp, os.stat(tmp).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    os.replace(tmp, dest)


#: Every installed command carries one of these. The name lands on somebody's
#: PATH, so it says whose it is at the point of use, and a manifest entry
#: without one is a mistake caught here rather than on a user's machine.
#:
#: `eo_` is the ecosystem's: commands that run inside a tree that is not this
#: one. `koine_` is this repository's own work, installed under the same name it
#: has in the tree -- one program with two names is worse than a longer name.
PREFIXES = ("eo_", "koine_")


def commands(origin):
    """The installable commands, in the order commands.json lists them."""
    return origin.get("commands", [])


def source_of(cmd):
    """Where a command's file is. `path` is relative to the checkout root.

    Most live in `eo_cmd/`, but a command can be installed from anywhere in the
    tree: `eo_append_db` is `bug_db/koine_append_db`, kept with the purpose it
    serves and installed under the name the convention requires.
    """
    if cmd.get("path"):
        return os.path.join(ROOT, cmd["path"])
    return os.path.join(STORE, cmd["name"])


def misnamed(origin):
    """Manifest entries whose installed name breaks the prefix convention."""
    return [c["name"] for c in commands(origin)
            if not c["name"].startswith(PREFIXES)]


def record(config, prefix):
    """What this script installed into that directory, by name.

    Keyed by directory. It was a single flat map until 2026-09-17, which meant
    installing to a second prefix made the first one's files look like somebody
    else's the next time they were installed to -- so they were skipped as
    foreign, and the copies nobody was tracking went quietly stale.
    """
    per = config.setdefault("installed", {})
    if per and not all(isinstance(v, dict) for v in per.values()):
        # the old flat shape, belonging to whatever prefix was in use
        config["installed"] = {config.get("prefix", ""): per}
        per = config["installed"]
    return per.setdefault(prefix, {})


def prefix_from(args, config):
    if args.prefix:
        return os.path.abspath(os.path.expanduser(args.prefix))
    if config.get("prefix"):
        return config["prefix"]
    return os.path.abspath(os.path.expanduser(DEFAULT_PREFIX))


def on_path(directory):
    entries = [os.path.abspath(os.path.expanduser(p))
               for p in os.environ.get("PATH", "").split(os.pathsep) if p]
    return directory in entries


#: Footings that are not repositories to clone. A child arrives inside its
#: parent; an outsider is tracked and is not ours to put on somebody's disk.
NOT_CLONED = {"child", "outsider"}


def do_init_clone(president, into, dry_run, named_dir=None):
    """Clone the ecosystem beside the president, from the register it holds.

    **This is not a command anybody installs.** Putting the ecosystem on a
    machine is something you do once, from the checkout you already have, and a
    command for it would have to be installed by this script first -- which
    means cloning the ecosystem would depend on having already set up the thing
    that clones the ecosystem. So it lives here, where somebody already is.

    The only command that installs anything is `git clone <url> <dir>`: no
    branch flags, nothing through a shell, so only a default branch is ever
    cloned. **A directory that already exists is reported and never touched** --
    a checkout is somebody's working tree and the cost of being wrong about that
    is theirs.
    """
    if not president:
        named = named_president(named_dir)
        if named:
            say(f"refused: {homely(named)} does not hold {REGISTER}, and "
                f"nothing else is read once a tree has been named. Name the "
                f"one that holds the register.", stream=sys.stderr)
        else:
            say("refused: no checkout holding the register was found, and the "
                "register is what says who to clone. Pass --president DIR.",
                stream=sys.stderr)
        return 2
    try:
        data, where = snapshot(president)
    except (OSError, ValueError) as exc:
        say(f"refused: {homely(president)}: {exc}", stream=sys.stderr)
        return 2

    todo, here = [], []
    for name, entry in sorted(data.items()):
        if not isinstance(entry, dict) or "status" not in entry:
            continue
        if entry["status"] in NOT_CLONED or not entry.get("url"):
            continue
        path = os.path.join(into, entry.get("repo") or name)
        (here if os.path.exists(path) else todo).append(
            (name, entry["status"], entry["url"], path))

    say(f"the register {where}")
    say(f"{len(todo) or 'nothing'} to clone into {homely(into)}"
        + (f"; {these(n for n, _, _, _ in here)} "
           f"{'is' if len(here) == 1 else 'are'} already there and left alone"
           if here else ""))
    # The lines a real run executes, as a person would type them: the point of
    # a dry run here is to read the git commands before they run.
    table([("git clone", url, homely(path)) for _, _, url, path in todo])
    if not todo:
        return 0
    if dry_run:
        say("dry run: nothing was cloned. The lines above are what a real run "
            "executes")
        return 0

    cloned, failed = [], []
    for name, footing, url, path in todo:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        out = subprocess.run(["git", "clone", url, path],
                             capture_output=True, text=True)
        if out.returncode == 0:
            cloned.append(name)
        else:
            failed.append(name)
            say(f"{name} did not clone: {(out.stderr or out.stdout).strip()}",
                stream=sys.stderr)
    if cloned:
        say(f"cloned {these(cloned)}, into {homely(into)}")
    if failed:
        say(f"{these(failed)} did not clone; the error from git is above",
            stream=sys.stderr)
    return 1 if failed else 0


def orphans(prefix, origin, config):
    """Files this script installed that the manifest no longer lists.

    Dropping a command from `commands.json` stops it being installed; it does
    not remove the copy already on somebody's path, which then goes stale
    forever with nothing pointing at it. The record says what we put there, so
    the difference is knowable and worth printing.
    """
    known = {c["name"] for c in commands(origin)}
    out = []
    for name, sha in record(config, prefix).items():
        if name in known:
            continue
        dest = os.path.join(prefix, name)
        if os.path.exists(dest):
            out.append((name, dest, digest(read_text(dest)) == sha))
    return out


def do_status(prefix, origin, config):
    """What is on this machine, in one table with its columns named.

    A row used to be three bare cells, so `eo_init  not ours  a file of that
    name...` left a reader to work out that the middle cell was a state and
    that the states were a closed set. The header names them, and the line
    under the table says what a person does about the two that are not
    `current`.
    """
    where = homely(prefix)
    say(f"the Eunoia commands in {where}, which is "
        + ("on your PATH" if on_path(prefix) else "NOT on your PATH"))
    installed = record(config, prefix)
    rows = []
    for cmd in commands(origin):
        name = cmd["name"]
        dest = os.path.join(prefix, name)
        src = source_of(cmd)
        if not os.path.exists(dest):
            rows.append((name, "not installed", ""))
            continue
        there = digest(read_text(dest))
        here = digest(read_text(src)) if os.path.exists(src) else None
        if installed.get(name) != there:
            rows.append((name, "not ours",
                         "a file of that name is there and this script did not "
                         "put it"))
        elif cmd.get("needs") == "register":
            # Never byte-identical to its source: the register is written into
            # it at install time. What it carries says when, so that is read
            # back rather than guessed at from a hash.
            note = embedded_note(dest)
            rows.append((name, "installed",
                         f"carries {note[0].lower()}{note[1:]}" if note else ""))
        elif there == here:
            rows.append((name, "current", ""))
        else:
            rows.append((name, "stale", "this checkout has a newer one"))
    for name, dest, ours in orphans(prefix, origin, config):
        rows.append((name, "orphaned",
                     "installed from here once and no longer offered"
                     + ("; --uninstall removes it" if ours
                        else ", and changed since, so --uninstall leaves it")))
    table(rows, head=("command", "state", "note"))
    states = {r[1] for r in rows}
    if "stale" in states or "not installed" in states:
        say("run this script with no arguments to install what is missing and "
            "bring the stale ones up to date")
    if "not ours" in states:
        say("a file this script did not install is never overwritten; --force "
            "is how you say to replace it anyway")
    if "installed" in states:
        # The one state that is not a comparison, and a reader is owed the
        # reason: a command carrying a register snapshot is never
        # byte-identical to the file it was copied from, so *current* is a
        # question this cannot answer about it.
        say("a command carrying a register snapshot cannot be compared to this "
            "checkout byte for byte, so it reads as installed rather than "
            "current; re-run this script to refresh the snapshot")
    return 0


def embedded_note(dest):
    """What an installed command says about the register it carries."""
    try:
        for line in read_text(dest).splitlines():
            if line.strip().startswith("# The register, "):
                return line.strip()[2:].rstrip(".")
    except OSError:
        pass
    return "carries a register snapshot"


def do_uninstall(prefix, origin, config, dry_run):
    """Remove what this script put there, and say what it would not touch.

    The files it declines to remove are the point of the report: a command
    somebody has edited is their file now, and a run that removed eight things
    and silently kept one owes them the sentence saying which and why.
    """
    installed = record(config, prefix)
    removed, left = [], []
    # Orphans too: a command this script installed and no longer offers is
    # still a file this script put on somebody's path.
    names = [c["name"] for c in commands(origin)]
    names += [n for n, _, _ in orphans(prefix, origin, config)]
    for name in names:
        dest = os.path.join(prefix, name)
        if not os.path.exists(dest):
            continue
        if installed.get(name) != digest(read_text(dest)):
            left.append(name)
            continue
        removed.append((f"rm {homely(dest)}", "", ""))
        if not dry_run:
            os.remove(dest)
            installed.pop(name, None)

    where = homely(prefix)
    counted = f"{len(removed)} " + ("removed" if not dry_run else "to remove")
    if left:
        counted += f", {len(left)} left alone"
    say((f"dry run: nothing was removed. The Eunoia commands in {where}: "
         if dry_run else f"the Eunoia commands in {where}: ") + counted)
    plan_lines(removed)
    if left:
        one = len(left) == 1
        say(f"{these(left)} {'was' if one else 'were'} left alone: "
            f"{'it has' if one else 'they have'} changed since this script "
            f"installed {'it' if one else 'them'}, which makes "
            f"{'it somebody' if one else 'them somebody'}'s own "
            f"{'file' if one else 'files'} and not this script's to delete. "
            f"Remove {'it' if one else 'them'} by hand to be rid of "
            f"{'it' if one else 'them'}.", stream=sys.stderr)
    if dry_run:
        return 0
    record(config, prefix).clear()
    record(config, prefix).update(installed)
    write_json(CONFIG, config)
    return 0


def short_of(cmd):
    """The one line a command gets beside its name in the roster.

    **The manifest's `short` if it has one, and the first sentence of `what` if
    it does not.** The register already carries the same pair for the same
    reason: `what` is the paragraph somebody reads once, `short` is the line
    that fits in a column. Cutting the long one down at its first full stop is
    what this did until 2026-09-18, and it produced cells three lines deep that
    stopped wherever the prose happened to have a full stop -- a roster nobody
    reads is a roster that may as well not print.
    """
    text = " ".join((cmd.get("short") or "").split())
    if text:
        return text
    what = " ".join((cmd.get("what") or "").split())
    return re.split(r"(?<=[.!?])\s+", what)[0].rstrip(".") if what else ""


#: The introduction to the roster after installation.
LEADS = {
    "ready": "You are now ready to use the Eunoia ecosystem. For quick start, "
             "try these:",
}


def say_ready(origin, how):
    """Close the run on what the person can now type, not on bookkeeping.

    **The report above says what happened; this says what to do with it.**
    Those are different questions and the first answers neither: a line reading
    `9 commands installed into ~/bin` tells somebody that names they
    have never seen are now on their path. So the run ends on the roster,
    addressed to them, and it goes last because the last thing printed is the
    thing that gets read.

    Dry runs print only copy commands and do not reach this roster.

    **It is stratified, because the roster is not one audience.** Most of these
    are for the person reading it, to type in a repository they are working in.
    `koine_append_db` is machinery: a pinned consumer or another tool's CI
    calls it, and somebody who has just installed the ecosystem has no occasion
    to. Leaving it in the same list as the rest implied they would type it;
    dropping it would hide a command that is on their PATH and that something
    on their machine may call. So it is listed, below the line, under a
    sentence saying a human can ignore it. The manifest says which is which --
    `audience: tooling` -- rather than this guessing from a name.

    The text is the manifest's, which is the same text the READMEs are written
    against -- so a command whose purpose moves says so here on the next
    install, and this stays a copy with an original rather than a second
    description going its own way.
    """
    rows = [(c["name"], short_of(c), c.get("audience") == "tooling")
            for c in commands(origin)]
    mine = [(n, w) for n, w, tooling in rows if w and not tooling]
    theirs = [(n, w) for n, w, tooling in rows if w and tooling]
    if not mine and not theirs:
        return
    print()
    print(textwrap.fill(LEADS[how], width=WIDTH))
    print()
    # No header over these two columns: a name and the line saying what it is
    # for need no label, and a roster of nine rows is short enough that a
    # header is one more line between the sentence and the thing it introduced.
    table(mine)
    print()
    say("run them in the root of the repository you are working in; every one "
        "takes --help, which says what it does and what forms it takes")
    if theirs:
        one = len(theirs) == 1
        print()
        say(f"{'one more is' if one else f'{len(theirs)} more are'} machinery "
            f"rather than {'a command' if one else 'commands'} for you -- "
            f"another tool's CI or an agent calls "
            f"{'it' if one else 'them'}, and you can ignore "
            f"{'it' if one else 'them'} if you are a human:")
        print()
        table(theirs)
        print()
    say("run this script again to update them; --status says what is "
        "installed, --verbose shows every file")


def do_install(prefix, origin, config, dry_run, force, verbose=False,
               president_dir=None):
    """Install, and report it to the person who ran it.

    **A run says three things, in the order somebody wants them**: what it did,
    anything they now have to do about it, and what they can type. Everything
    else -- which file went to which path, that a copy is written to a
    temporary name and renamed over the target, which config remembered the
    directory -- is true, was printed every run, and buried those three under a
    wall nobody read. It is printed under `--verbose`. A dry run prints only
    shell-quoted cp commands for the files the installation would copy.

    **Nothing that went wrong is left to be inferred from a table.** A file this
    script will not overwrite, a directory that is not on a PATH, a register
    that could not be read: each says what happened and what to do about it, in
    a sentence, near the top.
    """
    installed = dict(record(config, prefix))
    plan, copied, refreshed, current, left_alone = [], 0, 0, 0, []
    copy_plan = []
    detail = verbose
    where = homely(prefix)

    # Read once, so every command baked in this run carries the same snapshot.
    embed = None
    president = find_president(president_dir)
    if president:
        try:
            embed = snapshot(president)
        except (OSError, ValueError) as exc:
            if not dry_run:
                say(f"the register at {president} could not be read: {exc}",
                    stream=sys.stderr)
    elif not dry_run and any(c.get("needs") == "register" for c in commands(origin)):
        named = named_president(president_dir)
        readers = ", ".join(c["name"] for c in commands(origin)
                            if c.get("needs") == "register")
        missing = (f"{homely(named)} does not hold {REGISTER}"
                   if named else "no checkout holding the register was found")
        say(f"{readers} will install without a register snapshot, because "
            f"{missing}. It will then work only in the tree that holds the "
            f"register; --president DIR names that tree.", stream=sys.stderr)

    for cmd in commands(origin):
        name = cmd["name"]
        src = source_of(cmd)
        dest = os.path.join(prefix, name)
        if not os.path.exists(src):
            say(f"refused: {rel(src)} is missing, and nothing was installed",
                stream=sys.stderr)
            return 1
        want = digest(read_text(src))

        wants = cmd.get("needs") == "register"
        action, why = "install", f"from {rel(src)}"
        if os.path.exists(dest):
            there = digest(read_text(dest))
            ours = installed.get(name) == there
            if there == want or (wants and ours and not embed):
                action, why = "up to date", ""
                current += 1
                installed[name] = there
            elif ours:
                # A command carrying the register is never byte-identical to
                # its source, so *ours and different* is the ordinary case for
                # one of those and means a fresh snapshot, not a new version.
                action = "refresh" if wants and embed else "update"
                why = (f"from {rel(src)}, with a register snapshot taken now"
                       if action == "refresh" else f"from {rel(src)}")
            elif force:
                action = "replace"
                why = f"from {rel(src)}, over a file this script did not install"
            else:
                action = "left alone"
                why = ("a file of that name is there that this script did not "
                       "install")
                left_alone.append(name)
        if wants and action in ("install", "update", "replace"):
            why += (", with the register baked in" if embed
                    else ", with no register to bake in")
        plan.append((action, name, why))
        if action != "up to date" and action != "left alone":
            copied += 1
            refreshed += action == "refresh"
            copy_plan.append((src, dest))
            if not dry_run:
                install_file(src, dest, embed if wants else None)
                installed[name] = digest(read_text(dest))

    if dry_run:
        for src, dest in copy_plan:
            print(shlex.join(("cp", "--", src, dest)))
        return 0

    # What it did, in one sentence, with the directory named first: the
    # directory is the one thing every clause is about, and a count nobody can
    # place is not worth printing.
    counted = []
    if copied - refreshed:
        counted.append(f"{copied - refreshed} installed")
    if refreshed:
        # Said in full on its own line below: a count here and the sentence
        # there would be the same fact printed twice.
        counted.append(f"{refreshed} refreshed")
    if current:
        counted.append(f"{current} already up to date")
    if left_alone:
        counted.append(f"{len(left_alone)} left alone")
    summary = ", ".join(counted) or "nothing to do"
    say(summary)

    # Which register an installed command is carrying is not a detail: it is
    # the difference between a command that answers with today's ecosystem and
    # one that answers with a snapshot of it, and only this run knows when the
    # snapshot was taken.
    carriers = [name for action, name, _ in plan
                if action in ("install", "update", "replace", "refresh")
                and any(c["name"] == name and c.get("needs") == "register"
                        for c in commands(origin))]
    if carriers and embed:
        say(f"{these(carriers)} now carr{'ies' if len(carriers) == 1 else 'y'} "
            f"a snapshot of the register, {embed[1]}; run this script again "
            f"whenever the register moves")

    if detail:
        say(f"file by file, in {where}:")
        table(plan, head=("action", "command", "where from, or why not"))
        say("a copy, not a move: the source keeps every file, and each is "
            "written to a temporary file beside the target, made executable "
            "and renamed over it, so an interrupted run leaves the old file "
            "in place")

    # Anything the person has to decide about, said as a sentence rather than
    # left as a word in a column -- and said once, however many files it is
    # about.
    if left_alone:
        one = len(left_alone) == 1
        say(f"{these(left_alone)} {'was' if one else 'were'} left alone: "
            f"{'a file' if one else 'files'} of that name "
            f"{'is' if one else 'are'} already in {where} and this script did "
            f"not put {'it' if one else 'them'} there. Re-run with --force to "
            f"replace {'it' if one else 'them'}.")

    news = config.get("prefix") != prefix
    config["prefix"] = prefix
    record(config, prefix).update(installed)
    write_json(CONFIG, config)
    if news and prefix != os.path.abspath(os.path.expanduser(DEFAULT_PREFIX)):
        # Only when it is news worth having: remembering the default is not a
        # thing anybody needs telling, since a run with no arguments would
        # have gone there anyway.
        say(f"remembered {where}, so later runs of this script need no "
            f"arguments")
    if not on_path(prefix):
        # One line, and only when this shell cannot see the directory. The
        # default is `~/bin`, which a login shell puts on PATH on every system
        # these commands are meant for, so a run that stopped to explain PATH
        # was interrupting almost everybody to fix almost nobody -- and a run
        # started from cron or a Makefile has a PATH that says nothing about
        # the one the person types in.
        say(f"ensure that {where} is in your PATH: "
            f'export PATH="{shell_path(prefix)}:$PATH"')
    say_ready(origin, "ready")
    return 1 if left_alone else 0


#: --help has to answer *why would I run this*, which the option list cannot:
#: a reader who does not already know what `eo_cmd/` is learns from `--prefix
#: DIR  install here` only that something gets installed somewhere. Both jobs
#: are named, because the second one is usually wanted first and was invisible
#: from the option list entirely.
WHY = """\
Set up the Eunoia ecosystem on this machine. Two jobs, and a fresh machine
usually wants the second one first.

  the commands, onto a PATH
      Everything in eo_cmd/ is written to run INSIDE somebody else's
      repository -- the one being started, joined, tidied or answered --
      rather than inside this one. A command shaped like that is no use
      sitting in a checkout whose path somebody has to remember, so this
      copies each onto a directory on your PATH and remembers which, so
      later runs need no arguments. A run ends with the list of commands
      and a line saying what each is for, which is the part worth reading.

  the repositories, onto the disk
      --init-clone reads the register the president holds and clones the
      repositories named in it. Several of the installed commands look for
      sibling checkouts -- for the policy and the vision, for the register,
      for another tool's discussion file -- and do strictly less without
      them. It installs no commands, and --dry-run prints the git clone
      lines without running one.\
"""

HOW = """\
examples:
  install_eo --prefix ~/bin   install, and remember the directory
  install_eo                  later runs need no arguments
  install_eo --status         what is installed, and whether it is current
  install_eo --init-clone     put the ecosystem's repositories on this machine
  install_eo --dry-run        print only the planned cp commands; write nothing
  install_eo --verbose        and show every file, one row each

It never overwrites a file it did not install: that file is left alone, the run
says which one and why, and --force is a person's decision because the file
being replaced is theirs.\
"""


def main():
    parser = argparse.ArgumentParser(
        description=WHY, epilog=HOW,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--prefix", metavar="DIR",
                        help=f"install here and remember it (default {DEFAULT_PREFIX})")
    parser.add_argument("--status", action="store_true",
                        help="what is installed, where, and whether it is current")
    parser.add_argument("--uninstall", action="store_true",
                        help="remove the files this script installed")
    parser.add_argument("--init-clone", nargs="?", const=True, metavar="DIR",
                        help="clone the ecosystem's repositories, from the "
                             "register the president holds, into DIR (default: "
                             "beside the president). Installs no commands")
    parser.add_argument("--president", metavar="DIR",
                        help="the checkout holding the register, whose contents "
                             "are baked into the commands that read it. A tree "
                             "named here is used or refused, never replaced by "
                             "another")
    parser.add_argument("--force", action="store_true",
                        help="replace a file of the same name this script did not install")
    parser.add_argument("--verbose", action="store_true",
                        help="also show every file, where it came from and "
                             "what happened to it (ignored for install dry runs)")
    parser.add_argument("--dry-run", action="store_true",
                        help="write nothing; for installation, print only the "
                             "planned cp commands")
    args = parser.parse_args()

    try:
        origin = read_json(MANIFEST)
    except (OSError, ValueError) as exc:
        say(f"refused: {MANIFEST}: {exc}", stream=sys.stderr)
        return 1

    try:
        config = read_json(CONFIG, missing_ok=True)
    except ValueError as exc:
        say(f"refused: {CONFIG}: {exc}", stream=sys.stderr)
        return 1

    prefix = prefix_from(args, config)

    bad = misnamed(origin)
    if bad:
        say(f"refused: {', '.join(bad)} start with none of "
            + " or ".join(f"`{x}`" for x in PREFIXES)
            + ", which every installed command carries", stream=sys.stderr)
        return 1

    if args.init_clone is not None:
        president = find_president(args.president)
        into = (os.path.abspath(os.path.expanduser(args.init_clone))
                if args.init_clone is not True
                else os.path.dirname(president) if president else "")
        return do_init_clone(president, into, args.dry_run,
                             args.president)

    if args.status:
        return do_status(prefix, origin, config)
    if args.uninstall:
        return do_uninstall(prefix, origin, config, args.dry_run)

    # The first line says what this is about to do and where, because a
    # person who typed one command wants that answered before anything else --
    # and because the directory is read out of a config they last saw a while
    # ago and may not be the one they have in mind.
    if not args.dry_run:
        say(f"Installing Eunoia ecosystem scripts into {homely(prefix)}")

    if not args.dry_run and not os.path.isdir(prefix):
        try:
            os.makedirs(prefix)
        except OSError as exc:
            say(f"refused: {exc}", stream=sys.stderr)
            return 1
        say(f"created {homely(prefix)}")

    return do_install(prefix, origin, config, args.dry_run, args.force,
                      args.verbose, args.president)


if __name__ == "__main__":
    sys.exit(main())
