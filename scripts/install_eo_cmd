#!/usr/bin/env python3
"""install_eo_cmd -- set up the Eunoia ecosystem on this machine.

    scripts/install_eo_cmd --prefix ~/bin  # install the commands, and remember where
    scripts/install_eo_cmd                 # later runs need no arguments
    scripts/install_eo_cmd --status        # what is installed, and whether it is current
    scripts/install_eo_cmd --init-clone    # clone the ecosystem's repositories
    scripts/install_eo_cmd --uninstall     # remove what this script installed

**Two jobs, and between them they are what a machine needs before any of this
is usable.**

**The commands, onto a PATH.** Everything in `eo_cmd/` is written to run *inside
somebody else's repository* -- the one being started, joined, tidied or answered
-- rather than inside this one. A command shaped like that is no use sitting in
a checkout whose path somebody has to remember, so this copies each onto a
directory on their PATH and remembers which directory, so that later runs need
no arguments.

**The repositories, onto the disk.** `--init-clone` reads the register the
president holds and clones what is missing beside it. Several of the installed
commands go looking for sibling checkouts -- for the policy and the vision, for
the register, for another tool's discussion file -- and do strictly less without
them, so a fresh machine wants this before it wants anything else.

`eo_cmd/commands.json` lists what is installable. koine maintains those commands
under role `R35`; what joining *costs* is `R4`'s and stays with the office.

**They were copies until 2026-09-17**, kept byte-identical to kanon's
`prompts/join_eo` and `prompts/init_eo`, and this script policed that with a
`--sync` and a `--check` that re-derived each copy from its original. kanon then
deleted its pair and the role moved here, so there is no original to check
against and nothing left to police. Both options were removed rather than left
pointing at a repository that no longer holds the files.

## The configuration

`install_eo_cmd.local.json` at the root of this checkout, which the repository
ignores by the ecosystem's `*.local.json` convention. It records the directory
chosen and what was installed into it, so a later run can tell a file it
installed from a file somebody else's tooling put there under the same name.

**It never overwrites a file it did not install.** A name already taken in the
target directory is reported and skipped; `--force` is how a person overrides
that, and it is a person's call because the file being replaced is theirs.
"""

import argparse
import hashlib
import json
import os
import re
import datetime
import shutil
import stat
import subprocess
import sys
import textwrap

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
STORE = os.path.join(ROOT, "eo_cmd")
MANIFEST = os.path.join(STORE, "commands.json")
CONFIG = os.path.join(ROOT, "install_eo_cmd.local.json")

#: Where the commands go when nobody has said otherwise. A person's own bin
#: directory rather than anything shared: this installs somebody's tools for
#: them, and has no business writing where another account would see it.
DEFAULT_PREFIX = "~/bin"


def digest(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def rel(path):
    """A path as a person would type it, from the checkout they ran this in."""
    inside = os.path.relpath(path, ROOT)
    return path if inside.startswith(os.pardir) else inside


def plan_lines(rows):
    """Left-aligned `<op> <src> <dest>` lines, so a column can be read down."""
    if not rows:
        return
    width = max(len(row[0]) for row in rows)
    for left, right, why in rows:
        line = f"   {left:<{width}}  {right}" + (f"   ({why})" if why else "")
        print(line.rstrip())


def read_text(path):
    with open(path, encoding="utf-8") as handle:
        return handle.read()


def read_json(path, missing_ok=False):
    if missing_ok and not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def write_json(path, data):
    """Replace a file in one step, so an interrupted run leaves the old one."""
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, sort_keys=False)
        handle.write("\n")
    os.replace(tmp, path)


#: The register, relative to the root of the repository that holds it. Whoever
#: holds it is the president; nothing here decides that, it is read from the
#: file itself.
REGISTER = os.path.join("scripts", "ecosystem", "ecosystem.json")

#: The line a command carries when it wants the register baked in, and what it
#: is replaced with. A command that does not carry it gets nothing.
SENTINEL = "EMBEDDED = None"


def find_president(given=None):
    """The tree holding the register, and what we can say about its state.

    **Nothing here decides who the president is.** The register records that,
    and the tree that holds the register is the one to read it from.

    **A tree somebody named is used or refused, never replaced.** `--president`
    and `KANON` are somebody saying *read the register there*; if that tree does
    not hold one, falling through to a different tree would answer a question
    nobody asked, with a register whose age and provenance the run has no reason
    to trust. Only the unnamed case looks at a sibling of this checkout, which
    is a guess and is the one place a guess is the whole point.
    """
    named = given or os.environ.get("KANON", "")
    if named:
        named = os.path.abspath(os.path.expanduser(named))
        return named if os.path.isfile(os.path.join(named, REGISTER)) else ""
    sibling = os.path.join(os.path.dirname(ROOT), "kanon")
    return sibling if os.path.isfile(os.path.join(sibling, REGISTER)) else ""


def named_president(given=None):
    """The tree somebody named, if they named one. `""` if nobody did.

    Only for a message: a run that refuses should say *the tree you named holds
    no register* rather than *none was found*, which reads as though nobody had
    said where to look.
    """
    named = given or os.environ.get("KANON", "")
    return os.path.abspath(os.path.expanduser(named)) if named else ""


#: What an installed command actually reads out of an entry. Everything else in
#: the register is the office's business -- when a footing was vetted, why, the
#: commit somebody joined at -- and baking it in would put a copy of somebody's
#: reasoning on a stranger's disk with no way to keep it current.
KEEP = ("status", "url", "repo", "parent")

#: Footings first, in the order a reader takes the ecosystem in.
ORDER = ("president", "member", "associate", "candidate", "foundation",
         "outsider", "child")


def as_source(data, where):
    """The register as Python somebody can read, not a line of JSON.

    An installed command is a file people open. A single 23KB line of `{...}`
    in the middle of one is not a snapshot anybody can check against the
    register, which defeats the point of naming where it came from -- so this
    writes it out grouped by footing, one entry per line, sorted, with only the
    fields a command reads.
    """
    rows = {k: v for k, v in data.items()
            if isinstance(v, dict) and "status" in v}
    out = ["EMBEDDED = {",
           f"    # The register, {where}.",
           "    # Grouped by footing; only the fields these commands read.",
           "    # Re-install to refresh it. The live register is the office's.",
           ""]
    for footing in ORDER:
        group = sorted(k for k, v in rows.items() if v["status"] == footing)
        if not group:
            continue
        out.append(f"    # -- {footing} --")
        for name in group:
            entry = rows[name]
            fields = {k: entry[k] for k in KEEP if entry.get(k)}
            what = entry.get("short") or entry.get("what") or ""
            if what:
                fields["short"] = what
            body = ", ".join(f"{k!r}: {v!r}" for k, v in fields.items())
            out.append(f"    {name!r}: {{{body}}},")
        out.append("")
    unknown = sorted(k for k, v in rows.items() if v["status"] not in ORDER)
    if unknown:
        out.append("    # -- footings this version of the command did not know --")
        for name in unknown:
            out.append(f"    {name!r}: {rows[name]!r},")
    out.append("}")
    return "\n".join(out)


def snapshot(president):
    """The register as JSON, and a sentence saying where and when it came from.

    The provenance is not decoration. What gets baked into an installed command
    is a **snapshot**, and every run that falls back to it has to be able to say
    which commit it was taken at and whether that checkout was clean -- a
    snapshot from somebody's half-edited working tree is a different fact from
    one taken at a commit, and the reader is entitled to know which.
    """
    with open(os.path.join(president, REGISTER), encoding="utf-8") as handle:
        data = json.load(handle)
    commit = subprocess.run(["git", "-C", president, "rev-parse", "--short", "HEAD"],
                            capture_output=True, text=True)
    commit = commit.stdout.strip() if commit.returncode == 0 else ""
    dirty = subprocess.run(["git", "-C", president, "status", "--porcelain",
                            "--", REGISTER], capture_output=True, text=True)
    edited = bool(dirty.stdout.strip())
    where = f"from {os.path.basename(president)}"
    if commit:
        where += f" at {commit}"
        if edited:
            where += " with the register edited and not committed"
    where += f", on {datetime.date.today().isoformat()}"
    return data, where


def install_file(src, dest, embed=None):
    """Copy, executable, atomically -- baking in the register where asked."""
    tmp = dest + ".tmp"
    if embed is None:
        shutil.copyfile(src, tmp)
    else:
        data, where = embed
        text = read_text(src)
        if SENTINEL not in text:
            shutil.copyfile(src, tmp)
        else:
            text = text.replace(SENTINEL, as_source(data, where), 1)
            text = text.replace('EMBEDDED_FROM = ""',
                                f"EMBEDDED_FROM = {where!r}", 1)
            with open(tmp, "w", encoding="utf-8") as handle:
                handle.write(text)
    os.chmod(tmp, os.stat(tmp).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    os.replace(tmp, dest)


#: Every installed command carries one of these. The name lands on somebody's
#: PATH, so it says whose it is at the point of use, and a manifest entry
#: without one is a mistake caught here rather than on a user's machine.
#:
#: `eo_` is the ecosystem's: commands that run inside a tree that is not this
#: one. `koine_` is this repository's own work, installed under the same name it
#: has in the tree -- one program with two names is worse than a longer name.
PREFIXES = ("eo_", "koine_")


def commands(origin):
    """The installable commands, in the order commands.json lists them."""
    return origin.get("commands", [])


def source_of(cmd):
    """Where a command's file is. `path` is relative to the checkout root.

    Most live in `eo_cmd/`, but a command can be installed from anywhere in the
    tree: `eo_append_db` is `bug_db/koine_append_db`, kept with the purpose it
    serves and installed under the name the convention requires.
    """
    if cmd.get("path"):
        return os.path.join(ROOT, cmd["path"])
    return os.path.join(STORE, cmd["name"])


def misnamed(origin):
    """Manifest entries whose installed name breaks the prefix convention."""
    return [c["name"] for c in commands(origin)
            if not c["name"].startswith(PREFIXES)]


def record(config, prefix):
    """What this script installed into that directory, by name.

    Keyed by directory. It was a single flat map until 2026-09-17, which meant
    installing to a second prefix made the first one's files look like somebody
    else's the next time they were installed to -- so they were skipped as
    foreign, and the copies nobody was tracking went quietly stale.
    """
    per = config.setdefault("installed", {})
    if per and not all(isinstance(v, dict) for v in per.values()):
        # the old flat shape, belonging to whatever prefix was in use
        config["installed"] = {config.get("prefix", ""): per}
        per = config["installed"]
    return per.setdefault(prefix, {})


def prefix_from(args, config):
    if args.prefix:
        return os.path.abspath(os.path.expanduser(args.prefix))
    if config.get("prefix"):
        return config["prefix"]
    return os.path.abspath(os.path.expanduser(DEFAULT_PREFIX))


def on_path(directory):
    entries = [os.path.abspath(os.path.expanduser(p))
               for p in os.environ.get("PATH", "").split(os.pathsep) if p]
    return directory in entries


#: Footings that are not repositories to clone. A child arrives inside its
#: parent; an outsider is tracked and is not ours to put on somebody's disk.
NOT_CLONED = {"child", "outsider"}


def do_init_clone(president, into, dry_run, named_dir=None):
    """Clone the ecosystem beside the president, from the register it holds.

    **This is not a command anybody installs.** Putting the ecosystem on a
    machine is something you do once, from the checkout you already have, and a
    command for it would have to be installed by this script first -- which
    means cloning the ecosystem would depend on having already set up the thing
    that clones the ecosystem. So it lives here, where somebody already is.

    The only command that installs anything is `git clone <url> <dir>`: no
    branch flags, nothing through a shell, so only a default branch is ever
    cloned. **A directory that already exists is reported and never touched** --
    a checkout is somebody's working tree and the cost of being wrong about that
    is theirs.
    """
    if not president:
        named = named_president(named_dir)
        if named:
            print(f"-- refused: {named} does not hold {REGISTER}, and nothing "
                  f"else is\n   read once a tree has been named. Name the one "
                  f"that holds the register", file=sys.stderr)
        else:
            print("-- refused: no checkout holding the register was found, and "
                  "the register\n   is what says who to clone. Pass "
                  "--president DIR", file=sys.stderr)
        return 2
    try:
        data, where = snapshot(president)
    except (OSError, ValueError) as exc:
        print(f"-- refused: {president}: {exc}", file=sys.stderr)
        return 2

    todo, here = [], []
    for name, entry in sorted(data.items()):
        if not isinstance(entry, dict) or "status" not in entry:
            continue
        if entry["status"] in NOT_CLONED or not entry.get("url"):
            continue
        path = os.path.join(into, entry.get("repo") or name)
        (here if os.path.exists(path) else todo).append(
            (name, entry["status"], entry["url"], path))

    print(f"-- the register {where}")
    print(f"-- {len(todo)} to clone into {into}, {len(here)} already there")
    for name, footing, url, path in todo:
        print(f"   git clone {url} {path}")
    for name, footing, _, path in here:
        print(f"   -- {name}: already there, left alone")
    if not todo:
        return 0
    if dry_run:
        print("-- dry run: nothing was cloned. The lines above are what a real "
              "run executes")
        return 0

    failed = []
    for name, footing, url, path in todo:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        out = subprocess.run(["git", "clone", url, path],
                             capture_output=True, text=True)
        if out.returncode == 0:
            print(f"-- {name}: cloned")
        else:
            failed.append(name)
            print(f"-- {name}: did not clone -- "
                  f"{(out.stderr or out.stdout).strip()}", file=sys.stderr)
    print(f"-- {len(todo) - len(failed)} cloned, {len(failed)} failed"
          + (f": {', '.join(failed)}" if failed else ""))
    return 1 if failed else 0


def orphans(prefix, origin, config):
    """Files this script installed that the manifest no longer lists.

    Dropping a command from `commands.json` stops it being installed; it does
    not remove the copy already on somebody's path, which then goes stale
    forever with nothing pointing at it. The record says what we put there, so
    the difference is knowable and worth printing.
    """
    known = {c["name"] for c in commands(origin)}
    out = []
    for name, sha in record(config, prefix).items():
        if name in known:
            continue
        dest = os.path.join(prefix, name)
        if os.path.exists(dest):
            out.append((name, dest, digest(read_text(dest)) == sha))
    return out


def do_status(prefix, origin, config):
    print(f"-- {prefix}" + ("" if on_path(prefix) else "  (not on PATH)"))
    installed = record(config, prefix)
    rows = []
    for cmd in commands(origin):
        name = cmd["name"]
        dest = os.path.join(prefix, name)
        src = source_of(cmd)
        if not os.path.exists(dest):
            rows.append((name, "not installed", ""))
            continue
        there = digest(read_text(dest))
        here = digest(read_text(src)) if os.path.exists(src) else None
        if installed.get(name) != there:
            rows.append((name, "not ours",
                         "a file of that name is there and this script did not "
                         "put it"))
        elif cmd.get("needs") == "register":
            # Never byte-identical to its source: the register is written into
            # it at install time. What it carries says when, so that is read
            # back rather than guessed at from a hash.
            rows.append((name, "installed", embedded_note(dest)))
        elif there == here:
            rows.append((name, "current", ""))
        else:
            rows.append((name, "stale", "the source has moved; re-run to update"))
    for name, dest, ours in orphans(prefix, origin, config):
        rows.append((name, "orphaned",
                     "installed from here once and no longer offered"
                     + ("; --uninstall removes it" if ours
                        else ", and changed since, so --uninstall leaves it")))
    width = max((len(r[0]) for r in rows), default=0)
    state = max((len(r[1]) for r in rows), default=0)
    for name, said, note in rows:
        print(f"   {name:<{width}}  {said:<{state}}  {note}".rstrip())
    return 0


def embedded_note(dest):
    """What an installed command says about the register it carries."""
    try:
        for line in read_text(dest).splitlines():
            if line.strip().startswith("# The register, "):
                return line.strip()[2:].rstrip(".")
    except OSError:
        pass
    return "carries a register snapshot"


def do_uninstall(prefix, origin, config, dry_run):
    installed = record(config, prefix)
    removed, left = [], []
    # Orphans too: a command this script installed and no longer offers is
    # still a file this script put on somebody's path.
    names = [c["name"] for c in commands(origin)]
    names += [n for n, _, _ in orphans(prefix, origin, config)]
    for name in names:
        dest = os.path.join(prefix, name)
        if not os.path.exists(dest):
            continue
        if installed.get(name) != digest(read_text(dest)):
            left.append(name)
            continue
        removed.append((f"rm {dest}", "", ""))
        if not dry_run:
            os.remove(dest)
            installed.pop(name, None)

    for name in left:
        print(f"-- {name}: changed since this script installed it, and is left "
              "alone", file=sys.stderr)
    verb = "would remove" if dry_run else "removed"
    print(f"-- {verb} {len(removed)}, {len(left)} left alone  ->  {prefix}")
    plan_lines(removed)
    if dry_run:
        print(f"-- dry run: nothing was written, and {prefix} is unchanged")
        return 0
    record(config, prefix).clear()
    record(config, prefix).update(installed)
    write_json(CONFIG, config)
    return 0


def say_what_they_are(origin, prefix):
    """One line per command saying what it is for, after the plan.

    **The plan says what happened to each file; this says what each file is.**
    Those are different questions and the first one answers neither: a row
    reading `cp eo_cmd/eo_status ~/bin/eo_status (new)` tells somebody a name they
    now have on their path and nothing whatever about when they would type it.

    The text is the manifest's, which is the same text the READMEs are written
    against -- so a command whose purpose moves says so here on the next
    install, and this stays a copy with an original rather than a second
    description going its own way.
    """
    rows = [(c["name"], (c.get("what") or "").strip()) for c in commands(origin)]
    rows = [(n, w) for n, w in rows if w]
    if not rows:
        return
    width = max(len(n) for n, _ in rows)
    print(f"-- what each one is for, from {rel(os.path.join(STORE, 'commands.json'))}:")
    for name, what in rows:
        # One sentence is the purpose; anything after it is the caveat, and a
        # roster is not where a caveat earns its room.
        first = re.split(r"(?<=[.!?])\s+", what)[0].rstrip(".")
        body = textwrap.wrap(first, width=max(40, 74 - width))
        print(f"   {name:<{width}}  {body[0] if body else ''}")
        for line in body[1:]:
            print(f"   {'':<{width}}  {line}")


def do_install(prefix, origin, config, dry_run, force, president_dir=None):
    """Install, and say in full what that means.

    **Every command is listed every time**, with the verb that applies to it.
    A dry run that printed only what would change said nothing at all once a
    machine was up to date, which is exactly when somebody runs it to find out
    what the command does.
    """
    installed = dict(record(config, prefix))
    plan, copied, current, skipped = [], 0, 0, 0

    # Read once, so every command baked in this run carries the same snapshot.
    embed = None
    president = find_president(president_dir)
    if president:
        try:
            embed = snapshot(president)
        except (OSError, ValueError) as exc:
            print(f"-- the register at {president} could not be read: {exc}",
                  file=sys.stderr)
    elif any(c.get("needs") == "register" for c in commands(origin)):
        named = named_president(president_dir)
        where = (f"{named} does not hold {REGISTER}"
                 if named else "no president checkout found")
        print(f"-- {where}, so commands that read the "
              "register will\n   install without a snapshot and work only "
              "where the register is", file=sys.stderr)

    for cmd in commands(origin):
        name = cmd["name"]
        src = source_of(cmd)
        dest = os.path.join(prefix, name)
        if not os.path.exists(src):
            print(f"-- refused: {rel(src)} is missing, and nothing was "
                  "installed", file=sys.stderr)
            return 1
        want = digest(read_text(src))

        verb, why = "cp", "new"
        if os.path.exists(dest):
            there = digest(read_text(dest))
            ours = installed.get(name) == there
            if there == want or (cmd.get("needs") == "register"
                                 and installed.get(name) == there and not embed):
                verb, why = "skip", "already current"
                current += 1
                installed[name] = there
            elif ours:
                why = "replacing the copy this script installed"
            elif force:
                why = "replacing a file this script did not install, --force"
            else:
                verb, why = "skip", "exists and is not ours; --force replaces it"
                skipped += 1
        wants = cmd.get("needs") == "register"
        plan.append((verb, rel(src), dest,
                     ("refreshing the baked-in register"
                      if wants and embed and why.startswith("replacing")
                      else why + (", register baked in" if wants and embed else
                                  ", no register to bake in" if wants else ""))))
        if verb == "cp":
            copied += 1
            if not dry_run:
                install_file(src, dest, embed if wants else None)
                installed[name] = digest(read_text(dest))

    verb = "would install" if dry_run else "installed"
    print(f"-- {verb} {copied}, {current} already current, {skipped} skipped"
          f"  ->  {prefix}")
    verbs = max((len(row[0]) for row in plan), default=0)
    width = max((len(row[1]) for row in plan), default=0)
    dests = max((len(row[2]) for row in plan), default=0)
    for v, src, dest, why in plan:
        print(f"   {v:<{verbs}} {src:<{width}}  {dest:<{dests}}   ({why})")

    say_what_they_are(origin, prefix)

    if copied:
        print("-- a copy, not a move: the source keeps every file, and each one "
              "is written")
        print("   to a temporary file beside the target, made executable, and "
              "renamed over")
        print("   it, so an interrupted run leaves the old file in place")
    if dry_run:
        print(f"-- dry run: nothing was written, and {prefix} is unchanged")
        return 0

    config["prefix"] = prefix
    record(config, prefix).update(installed)
    write_json(CONFIG, config)
    print(f"-- remembered {prefix} in {os.path.relpath(CONFIG, ROOT)}")
    if not on_path(prefix):
        print(f"-- note: {prefix} is not on your PATH, so the commands above "
              "are installed and not yet reachable")
    return 1 if skipped else 0


#: --help has to answer *why would I run this*, which the option list cannot:
#: a reader who does not already know what `eo_cmd/` is learns from `--prefix
#: DIR  install here` only that something gets installed somewhere. Both jobs
#: are named, because the second one is usually wanted first and was invisible
#: from the option list entirely.
WHY = """\
Set up the Eunoia ecosystem on this machine. Two jobs, and a fresh machine
usually wants the second one first.

  the commands, onto a PATH
      Everything in eo_cmd/ is written to run INSIDE somebody else's
      repository -- the one being started, joined, tidied or answered --
      rather than inside this one. A command shaped like that is no use
      sitting in a checkout whose path somebody has to remember, so this
      copies each onto a directory on your PATH and remembers which, so
      later runs need no arguments. A run lists every command with a line
      saying what it is for.

  the repositories, onto the disk
      --init-clone reads the register the president holds and clones the
      repositories named in it. Several of the installed commands look for
      sibling checkouts -- for the policy and the vision, for the register,
      for another tool's discussion file -- and do strictly less without
      them. It installs no commands, and --dry-run prints the git clone
      lines without running one.\
"""

HOW = """\
examples:
  install_eo_cmd --prefix ~/bin   install, and remember the directory
  install_eo_cmd                  later runs need no arguments
  install_eo_cmd --status         what is installed, and whether it is current
  install_eo_cmd --init-clone     put the ecosystem's repositories on this machine
  install_eo_cmd --dry-run        say what would happen, and write nothing

It never overwrites a file it did not install; that row is skipped and says so,
and --force is a person's decision because the file being replaced is theirs.\
"""


def main():
    parser = argparse.ArgumentParser(
        description=WHY, epilog=HOW,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--prefix", metavar="DIR",
                        help=f"install here and remember it (default {DEFAULT_PREFIX})")
    parser.add_argument("--status", action="store_true",
                        help="what is installed, where, and whether it is current")
    parser.add_argument("--uninstall", action="store_true",
                        help="remove the files this script installed")
    parser.add_argument("--init-clone", nargs="?", const=True, metavar="DIR",
                        help="clone the ecosystem's repositories, from the "
                             "register the president holds, into DIR (default: "
                             "beside the president). Installs no commands")
    parser.add_argument("--president", metavar="DIR",
                        help="the checkout holding the register, whose contents "
                             "are baked into the commands that read it. A tree "
                             "named here is used or refused, never replaced by "
                             "another")
    parser.add_argument("--force", action="store_true",
                        help="replace a file of the same name this script did not install")
    parser.add_argument("--dry-run", action="store_true",
                        help="say what would happen and write nothing")
    args = parser.parse_args()

    try:
        origin = read_json(MANIFEST)
    except (OSError, ValueError) as exc:
        print(f"-- refused: {exc}", file=sys.stderr)
        return 1

    try:
        config = read_json(CONFIG, missing_ok=True)
    except ValueError as exc:
        print(f"-- refused: {CONFIG}: {exc}", file=sys.stderr)
        return 1

    prefix = prefix_from(args, config)

    bad = misnamed(origin)
    if bad:
        print(f"-- refused: {', '.join(bad)} start with none of "
              + " or ".join(f"`{x}`" for x in PREFIXES)
              + ", which every installed command carries", file=sys.stderr)
        return 1

    if args.init_clone is not None:
        president = find_president(args.president)
        into = (os.path.abspath(os.path.expanduser(args.init_clone))
                if args.init_clone is not True
                else os.path.dirname(president) if president else "")
        return do_init_clone(president, into, args.dry_run,
                             args.president)

    if args.status:
        return do_status(prefix, origin, config)
    if args.uninstall:
        return do_uninstall(prefix, origin, config, args.dry_run)

    if not os.path.isdir(prefix):
        if args.dry_run:
            print(f"-- dry run: {prefix} does not exist and would be created")
        else:
            try:
                os.makedirs(prefix)
            except OSError as exc:
                print(f"-- refused: {exc}", file=sys.stderr)
                return 1
            print(f"-- created {prefix}")

    return do_install(prefix, origin, config, args.dry_run, args.force,
                      args.president)


if __name__ == "__main__":
    sys.exit(main())
